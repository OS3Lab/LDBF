+	}
+
+	if os.Getenv("LDBF_REUSE_BPF_INSN") == "" {
+		bpfProgExecuated, err := Ldbf.CheckBpfProgExecuated(bpfProg)
+		if err != nil {
+			// fmt.Printf("Error checking BPF program is executed: %v\n", err)
+			return nil
+		}
+		if bpfProgExecuated {
+			return nil
+		}
+	}
+
+	// fmt.Println("Ldbf_prog: GenBpfInsnMap:")
+	// for k, v := range BpfProg.GenBpfInsnMap {
+	// 	fmt.Printf("\tbpfprog.GenBpfInsnMap %s: %s\n", k, v)
+	// }
+
+	return bpfProg
+}
