+// BPF instruction classes and codes
+const (
+	// Each BPF instruction is represented by 5 uint64 elements.
+	RAW_INSN_PER_LEN = 5
+
+	// For BPF_MOV64_IMM
+	BPF_ALU64     = 0x07
+	BPF_MOV       = 0xb0
+	BPF_K         = 0x00
+	BPF_MOV64_IMM = BPF_ALU64 | BPF_MOV | BPF_K // 0xb7
+
+	// For BPF_LD_IMM64
+	BPF_LD       = 0x00
+	BPF_DW       = 0x18
+	BPF_IMM      = 0x00
+	BPF_LD_IMM64 = BPF_LD | BPF_DW | BPF_IMM // 0x18
+
+	// Registers and pseudo-registers
+	BPF_REG_0         = 0
+	BPF_REG_1         = 1
+	BPF_REG_2         = 2
+	BPF_PSEUDO_MAP_FD = BPF_REG_1
+)
+
+// ParseRawInsnAssignArgs iterates through a BPF instruction stream.
+// It identifies all BPF_LD_MAP_FD pseudo-instructions. If the destination
+// register of such an instruction is neither BPF_REG_1 nor BPF_REG_2, it replaces
+// the 10-element (16-byte) pseudo-instruction with a 5-element (8-byte)
+// BPF_MOV64_IMM instruction.
+// BPF_REG_1 and BPF_REG_2 are preserved because they are used by helper functions
+// that accept map FDs as arguments (e.g., BPF_FUNC_map_lookup_elem uses R1,
+// BPF_FUNC_tail_call uses R2).
+func ParseRawInsnAssignArgs(r *randGen, result []uint64) []uint64 {
+	var newResult []uint64
+	newResult = make([]uint64, 0, len(result))
+	patchRate := 0.8
+
+	if r.Float64() > patchRate {
+		return result
+	}
+
+	i := 0
+	for i < len(result) {
+		// Check if there are enough elements left for a potential LD_MAP_FD (2 instructions).
+		if i+(2*RAW_INSN_PER_LEN) > len(result) {
+			newResult = append(newResult, result[i:]...)
+			break
+		}
+
+		code1 := result[i]
+		code2 := result[i+RAW_INSN_PER_LEN]
+
+		dstReg := result[i+1]
+		srcReg := result[i+2]
+
+		// fmt.Printf("Inspecting instructions at index %d and %d: code1=0x%x, dstReg=%d, srcReg=%d, code2=0x%x\n", i/RAW_INSN_PER_LEN, (i/RAW_INSN_PER_LEN)+1, code1, dstReg, srcReg, code2)
+
+		// Check for the BPF_LD_MAP_FD pseudo-instruction pattern:
+		// Insn 1: opcode=LD_IMM64, src_reg=BPF_PSEUDO_MAP_FD
+		// Insn 2: opcode=0
+		if code1 == BPF_LD_IMM64 && srcReg == BPF_PSEUDO_MAP_FD && code2 == 0 {
+			// It's a BPF_LD_MAP_FD. Now check the destination register.
+			// fmt.Printf("Found BPF_LD_MAP_FD at instruction index %d, dstReg=%d\n", i/RAW_INSN_PER_LEN, dstReg)
+			// BPF_REG_2 is defined as 2
+			if dstReg != BPF_REG_1 && dstReg != BPF_REG_2 {
+				// Condition met: Replace with BPF_MOV64_IMM(dstReg, 0).
+				// fmt.Printf("Replacing BPF_LD_MAP_FD(R%d, ...) at index %d with BPF_MOV64_IMM(R%d, 0)\n", dstReg, i/RAW_INSN_PER_LEN, dstReg)
+
+				// For BPF_MOV64_IMM, src_reg is 0. The regs field is just dstReg.
+				newRegs := dstReg
+				movInsn := []uint64{BPF_MOV64_IMM, newRegs, 0, 0, 0}
+				newResult = append(newResult, movInsn...)
+
+				// Skip the original 2 instructions (10 elements).
+				i += 2 * RAW_INSN_PER_LEN
+			} else {
+				// It's a valid LD_MAP_FD(BPF_REG_1, ...) or LD_MAP_FD(BPF_REG_2, ...), so we keep it.
+				newResult = append(newResult, result[i:i+(2*RAW_INSN_PER_LEN)]...)
+				i += 2 * RAW_INSN_PER_LEN
+			}
+		} else {
+			// It's not a LD_MAP_FD, copy the single instruction as is.
+			newResult = append(newResult, result[i:i+RAW_INSN_PER_LEN]...)
+			i += RAW_INSN_PER_LEN
+		}
+	}
+	return newResult
+}
+
+// ParseRawInsnReturnCode handles a special case:
+// If the last instruction before a BPF program exit sets R0 with a value greater than 1,
+// this function forces that immediate value to 0 or 1.
+func ParseRawInsnReturnCode(r *randGen, result []uint64) {
+	RAW_INSN_PER_LEN := 5
+	numInsns := len(result) / RAW_INSN_PER_LEN
+	// patchRate := 0.8
+	immToZeroRate := 0.5
+	var newImm uint64
+
+	// if r.Float64() > patchRate {
+	// 	return
+	// }
+
+	// Randomly choose the new immediate value (0 or 1)
+	if r.Float64() < immToZeroRate {
+		newImm = 0
+	} else {
+		newImm = 1
+	}
+
+	// Check for BPF_LD_IMM64(BPF_REG_0, IMM)
+	// This is a 2-instruction sequence, so we need at least 3 instructions total
+	// (LD_IMM_PART1, LD_IMM_PART2, EXIT).
+	if numInsns >= 3 {
+		thirdLastInsnIndex := (numInsns - 3) * RAW_INSN_PER_LEN
+		secondLastInsnIndex := (numInsns - 2) * RAW_INSN_PER_LEN
+
+		codePart1 := result[thirdLastInsnIndex]
+		regsPart1 := result[thirdLastInsnIndex+1]
+		codePart2 := result[secondLastInsnIndex] // The second part of LD_IMM64 has opcode 0
+
+		// Check if the pattern matches BPF_LD_IMM64(BPF_REG_0, ...)
+		if codePart1 == BPF_LD_IMM64 && regsPart1 == BPF_REG_0 && codePart2 == 0 {
+			// Reconstruct the original 64-bit immediate for logging purposes
+			// originalImmLow := result[thirdLastInsnIndex+4]
+			// originalImmHigh := result[secondLastInsnIndex+4]
+			// originalImm := (originalImmHigh << 32) | originalImmLow
+
+			// fmt.Printf("Found BPF_LD_IMM64 with R0 at instruction index %d, original IMM=0x%x. Modifying to 0x%x.\n",
+			// thirdLastInsnIndex/RAW_INSN_PER_LEN, originalImm, newImm)
+
+			// Write the new immediate back, split into lower and upper 32 bits
+			result[thirdLastInsnIndex+4] = newImm
+			result[secondLastInsnIndex+4] = 0
+
+			return
+		}
+	}
+
+	// This logic is preserved and runs only if the BPF_LD_IMM64 case above was not found.
+	// This is a single instruction, so we need at least 2 instructions total (MOV_IMM, EXIT).
+	if numInsns >= 2 {
+		insnStartIndex := (numInsns - 2) * RAW_INSN_PER_LEN
+		code := result[insnStartIndex]
+		regs := result[insnStartIndex+1]
+
+		// fmt.Printf("Inspecting instruction at index %d: opcode=0x%x, regs=0x%x\n", insnStartIndex/RAW_INSN_PER_LEN, code, regs)
+
+		// Check if this is the BPF_MOV64_IMM(BPF_REG_0, IMM) instruction we are looking for.
+		if code == BPF_MOV64_IMM && regs == BPF_REG_0 {
+			imm := result[insnStartIndex+4]
+			// fmt.Printf("Found BPF_MOV64_IMM with R0 at instruction index %d, original IMM=0x%x. Modifying to 0x%x.\n", insnStartIndex/RAW_INSN_PER_LEN, imm, newImm)
+
+			if imm > 1 {
+				result[insnStartIndex+4] = newImm
+			}
+		}
+	}
+}
+
+func ParseBpfRawInsnString(data string) ([]uint64, error) {
+	// 1. Clean the string: remove curly braces {} and extra spaces.
+	cleanedData := strings.ReplaceAll(data, "{", "")
+	cleanedData = strings.ReplaceAll(cleanedData, "}", "")
+	cleanedData = strings.TrimSpace(cleanedData)
+
+	// 2. Split the string by commas to get string representations of each hex number.
+	hexStrings := strings.Split(cleanedData, ",")
+
+	// 3. Create a slice to store the converted uint64 values.
+	var result []uint64
+	result = make([]uint64, 0, len(hexStrings)) // Pre-allocating capacity can improve efficiency.
+
+	// 4. Iterate over the split strings and convert each hex string to a uint64.
+	for i, hexStr := range hexStrings {
+		// Trim whitespace from each hex string.
+		trimmedHexStr := strings.TrimSpace(hexStr)
+
+		// Skip empty strings (which can result from consecutive commas or leading/trailing commas).
+		if trimmedHexStr == "" {
+			continue
+		}
+
+		// Use strconv.ParseUint to convert the hex string to a uint64.
+		// Parameters:
+		// - trimmedHexStr: The string to convert.
+		// - 0: Auto-detect the base (supports "0x" prefix for hex).
+		// - 64: The target integer type is a 64-bit unsigned integer (uint64).
+		val, err := strconv.ParseUint(trimmedHexStr, 0, 64)
+		if err != nil {
+			// If conversion fails, return an error.
+			return nil, fmt.Errorf("failed to parse hex string '%s' at index %d: %w", trimmedHexStr, i, err)
+		}
+
+		// Append the converted uint64 value to the result slice.
+		result = append(result, val)
+	}
+
+	return result, nil
+}
