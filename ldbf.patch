+// PatchBpfProgTestRunFlowDissector constructs valid parameters for a flow_dissector program.
+func PatchBpfProgTestRunFlowDissector(r *randGen, bpfProg *BpfProg) BpfProgTestRunStruct {
+	// DataSizeIn must be at least ETH_HLEN. We use a reasonable upper bound.
+	dataSizeIn := uint32(ETH_HLEN + r.Intn(MAX_Data_SIZE_IN))
+	dataIn := make([]byte, dataSizeIn)
+	for i := range dataIn {
+		dataIn[i] = byte(r.Intn(256))
+	}
+
+	// The context for a flow dissector is `struct bpf_flow_keys`.
+	ctxIn := NewValidBpfFlowKeysForTestRun(r)
+	ctxSizeIn := uint32(len(ctxIn))
+
+	// The kernel copies out the resulting flow_keys to both data_out and ctx_out.
+	dataOut := make([]byte, dataSizeIn)
+	ctxOut := make([]byte, ctxSizeIn)
+
+	// From the kernel source `bpf_prog_test_run_flow_dissector`:
+	// `flags`, `cpu`, and `batch_size` must be zero.
+	return BpfProgTestRunStruct{
+		ProgFD: bpfProg.BpfProgContext.ProgFD,
+
+		DataSizeIn:  dataSizeIn,
+		DataSizeOut: uint32(len(dataOut)),
+		DataIn:      dataIn,
+		DataOut:     dataOut,
+
+		Repeat:   1, // Kernel defaults to 1 if 0.
+		Duration: uint32(r.Intn(REPEAT_TIMES)),
+
+		CtxSizeIn:  ctxSizeIn,
+		CtxSizeOut: uint32(len(ctxOut)),
+		CtxIn:      ctxIn,
+		CtxOut:     ctxOut,
+
+		Flags:     0,
+		Cpu:       0,
+		BatchSize: 0,
+	}
+}
