+type KernelLogManager struct {
+	mu      sync.Mutex
+	writers map[int]*os.File      // vmIndex -> file handler
+	buffers map[int]*bytes.Buffer // vmIndex -> buffer for partial lines
+	logDir  string
+	enabled bool
+}
+
+func getKernelLogManager() *KernelLogManager {
+	kernelLogOnce.Do(func() {
+		var enabled bool
+		// get logDir from environment variable or config
+		logDir := os.Getenv("LDBF_KERNEL_LOG_DIR")
+		if logDir != "" {
+			logDir = filepath.Join(logDir)
+			enabled = true
+		} else {
+			enabled = false
+		}
+
+		kernelLogManager = &KernelLogManager{
+			writers: make(map[int]*os.File),
+			buffers: make(map[int]*bytes.Buffer),
+			logDir:  logDir,
+			enabled: enabled,
+		}
+
+		if enabled {
+			os.MkdirAll(logDir, osutil.DefaultDirPerm)
+		}
+	})
+	return kernelLogManager
+}
+
+func saveKernelLogRealtime(vmIndex int, data []byte) {
+	manager := getKernelLogManager()
+	if !manager.enabled || len(data) == 0 {
+		return
+	}
+
+	manager.mu.Lock()
+	defer manager.mu.Unlock()
+
+	// access or create the log file for this VM
+	writer, exists := manager.writers[vmIndex]
+	if !exists {
+		filename := fmt.Sprintf("vm_%d_kernel.log", vmIndex)
+		filepath := filepath.Join(manager.logDir, filename)
+
+		file, err := os.OpenFile(filepath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, osutil.DefaultFilePerm)
+		if err != nil {
+			return
+		}
+
+		manager.writers[vmIndex] = file
+		manager.buffers[vmIndex] = &bytes.Buffer{}
+		writer = file
+
+		// write start timestamp
+		timestamp := time.Now().Format("2006-01-02 15:04:05")
+		writer.WriteString(fmt.Sprintf("\n=== VM %d kernel log started at %s ===\n", vmIndex, timestamp))
+	}
+
+	// get the buffer
+	buffer := manager.buffers[vmIndex]
+
+	// write data to buffer
+	buffer.Write(data)
+
+	// for each complete line, write to file
+	for {
+		line, err := buffer.ReadBytes('\n')
+		if err != nil {
+			// if no complete line, put data back to buffer
+			buffer = &bytes.Buffer{}
+			buffer.Write(line)
+			manager.buffers[vmIndex] = buffer
+			break
+		}
+
+		// add time stamp prefix (optional)
+		timestamp := time.Now().Format("15:04:05.000")
+		timestampedLine := fmt.Sprintf("[%s] %s", timestamp, string(line))
+
+		if _, err := writer.WriteString(timestampedLine); err == nil {
+			// flush to disk
+			writer.Sync()
+		}
+	}
+}
