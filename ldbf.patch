+func ReadFileContent(filePath string) (string, error) {
+	content, err := os.ReadFile(filePath)
+	if err != nil {
+		return "", fmt.Errorf("error read file content %s: %w", filePath, err)
+	}
+	return string(content), nil
+}
+
+// extractBPFInsnFromContent scans the given string content and prints lines
+// that appear to be BPF instructions.
+func ExtractBPFInsnFromContent(content string) string {
+	// Use strings.Builder to efficiently build the final string
+	var builder strings.Builder
+
+	// The regular expression remains the same, and is used to find command lines starting with "BPF_"
+	bpfInstructionRegex := regexp.MustCompile(`^\s*BPF_`)
+
+	// Use scanner to read the content line by line
+	scanner := bufio.NewScanner(strings.NewReader(content))
+	for scanner.Scan() {
+		line := scanner.Text()
+		// Check if the current line matches a BPF instruction regular expression
+		if bpfInstructionRegex.MatchString(line) {
+			// If it matches, append the line and a newline to the builder
+			builder.WriteString(line)
+			builder.WriteString("\n")
+		}
+	}
+
+	// Returns the complete string constructed in builder
+	return builder.String()
+}
+
+func SelectRandomFileAndRead(targetDir string) (string, string, error) {
+	var files []string
+	err := filepath.WalkDir(targetDir, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !d.IsDir() && !strings.HasSuffix(strings.ToLower(path), ".json") {
+			files = append(files, path)
+		}
+		return nil
+	})
+	if err != nil {
+		return "", "", fmt.Errorf("遍历目录失败: %w", err)
+	}
+
+	if len(files) == 0 {
+		return "", "", fmt.Errorf("目标文件夹下没有符合条件的文件")
+	}
+
+	r := rand.New(rand.NewSource(time.Now().UnixNano()))
+	randomIndex := r.Intn(len(files))
+	selectedFile := files[randomIndex]
+
+	content, err := ReadFileContent(selectedFile)
+	bpfInsnContent := ExtractBPFInsnFromContent(content)
+	if err != nil {
+		return "", "", err
+	}
+
+	return selectedFile, bpfInsnContent, nil
+}
