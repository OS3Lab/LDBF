+func initLdbfProgTypeMap() {
+	bpfProgTypeMap = make(map[string]BpfProgTypeStruct)
+	for _, def := range bpfProgTypeArray {
+		bpfProgTypeMap[def.Name] = def
+	}
+}
+
+// ExtractSupportedProgTypes extracts helper functions from the BPF IR content
+// and calculates the list of commonly supported prog_type based on dependencies.
+func ExtractSupportedProgTypes(bpfProg *BpfProg, jsonDependencies string) ([]string, error) {
+	// 1. Parse JSON dependencies.
+	var dependencies map[string][]string
+	if err := json.Unmarshal([]byte(jsonDependencies), &dependencies); err != nil {
+		return nil, fmt.Errorf("failed to parse dependency JSON file: %w", err)
+	}
+
+	// 2. Use regular expressions to extract all helper function names from the BPF IR.
+	//    This regex can match forms like BPF_RAW_INSN(...) and BPF_EMIT_CALL(...).
+	var helperRegex = regexp.MustCompile(`(?:BPF_RAW_INSN|BPF_EMIT_CALL)\((?:.*,\s*)?(\w+)\)`)
+	matches := helperRegex.FindAllStringSubmatch(bpfProg.BpfProgContent, -1)
+
+	foundHelpers := make(map[string]struct{}) // Use a set to remove duplicates.
+	for _, match := range matches {
+		if len(match) > 1 {
+			// Convert helper name to uppercase to match keys in the JSON.
+			foundHelpers[strings.ToUpper(match[1])] = struct{}{}
+		}
+	}
+
+	// fmt.Printf("\nExtracted helper functions from BPF IR: %v\n", foundHelpers)
+
+	// Convert the contents of dependencies to all uppercase
+	upperDependencies := make(map[string][]string)
+	for key, valueSlice := range dependencies {
+		upperKey := strings.ToUpper(key)
+		upperValueSlice := make([]string, len(valueSlice))
+		for i, value := range valueSlice {
+			upperValueSlice[i] = strings.ToUpper(value)
+		}
+		upperDependencies[upperKey] = upperValueSlice
+	}
+	dependencies = upperDependencies
+
+	// 3. Filter out helpers that have actual prog_type constraints in the JSON.
+	//    According to the rule, a helper with an empty prog_type list is considered a "wildcard"
+	//    and is ignored during intersection calculation.
+	var definedHelpers []string
+	for helper := range foundHelpers {
+		if progTypes, ok := dependencies[helper]; ok && len(progTypes) > 0 {
+			definedHelpers = append(definedHelpers, helper)
+		}
+		// fmt.Printf("Helper function used: %s, definedHelpers: %v, progTypes: %v\n\n", helper, definedHelpers, dependencies[helper])
+	}
+	// fmt.Printf("Defined helpers with constraints: %v, from program: %v\n", definedHelpers, bpfProg.BpfProgContent)
+
+	// 4. Calculate the final list of supported prog_types.
+	// Case A: If no helpers with actual constraints are found
+	// (possibly because there are no helpers in the IR, or all helpers are "wildcards").
+	if len(definedHelpers) == 0 {
+		// In this case, by default, all known prog_types are supported.
+		// We collect all prog_types that appear in the dependencies map.
+		allProgTypesSet := make(map[string]struct{})
+		for _, progTypes := range dependencies {
+			for _, pt := range progTypes {
+				allProgTypesSet[pt] = struct{}{}
+			}
+		}
+
+		result := make([]string, 0, len(allProgTypesSet))
+		for pt := range allProgTypesSet {
+			result = append(result, pt)
+		}
+		return result, nil
+	}
+
+	// Case B: Calculate the intersection of prog_types supported by all defined helpers.
+	// a. Initialize the intersection set with the list from the first helper.
+	initialProgTypes := dependencies[definedHelpers[0]]
+	intersectionSet := make(map[string]struct{})
+	for _, pt := range initialProgTypes {
+		intersectionSet[pt] = struct{}{}
+	}
+
+	// b. Iterate through the remaining helpers, narrowing down the intersection.
+	for i := 1; i < len(definedHelpers); i++ {
+		nextProgTypes := dependencies[definedHelpers[i]]
+
+		// Create a temporary set to store the new intersection for this iteration.
+		nextIntersectionSet := make(map[string]struct{})
+		for _, pt := range nextProgTypes {
+			// If the current prog_type also exists in the main intersection set, keep it.
+			if _, exists := intersectionSet[pt]; exists {
+				nextIntersectionSet[pt] = struct{}{}
+			}
+		}
+
+		// Update the main intersection set.
+		intersectionSet = nextIntersectionSet
+
+		// Optimization: if the intersection becomes empty midway, we can stop early.
+		if len(intersectionSet) == 0 {
+			break
+		}
+	}
+
+	// c. Convert the final intersection set back to a slice.
+	finalResult := make([]string, 0, len(intersectionSet))
+	for pt := range intersectionSet {
+		finalResult = append(finalResult, pt)
+	}
+
+	return finalResult, nil
+}
+
+// RandomSelectProgType calls the analysis function and randomly selects a prog type's numerical value from the result.
+func RandomSelectProgType(r *randGen, bpfProg *BpfProg) (uint64, error) {
+	// 1. Call the function to get the list of allowed prog_type names.
+	LDBFDir := os.Getenv("LDBF_DIR") + "/"
+	if LDBFDir == "/" {
+		panic("LDBF_DIR environment variable is not set")
+	}
+
+	helperProgTypeFile := LDBFDir + "dependency/func_prog.json"
+	dependenciesJSON, err := ReadFileContent(helperProgTypeFile)
+	if err != nil {
+		return 0, err
+	}
+
+	supportedProgTypes, err := ExtractSupportedProgTypes(bpfProg, dependenciesJSON)
+	if err != nil {
+		return 0, fmt.Errorf("error extracting supported prog types: %w", err)
+	}
+
+	// 2. Build the candidate pool using the efficient bpfProgTypeMap.
+	var candidates []BpfProgTypeStruct
+	if len(supportedProgTypes) > 0 {
+		candidates = make([]BpfProgTypeStruct, 0, len(supportedProgTypes))
+		// Iterate through the allowed names and perform a fast lookup in the map.
+		for _, name := range supportedProgTypes {
+			if progType, ok := bpfProgTypeMap[name]; ok {
+				candidates = append(candidates, progType)
+			}
+		}
+	}
+
+	// 3. If the candidate pool is empty (either initially or after filtering), use all types as a fallback.
+	if len(candidates) == 0 {
+		// fmt.Println("Warning: Candidate pool is empty, selecting randomly from all known prog_types.")
+		// Populate candidates from the map's values.
+		candidates = make([]BpfProgTypeStruct, 0, len(bpfProgTypeMap))
+		for _, progType := range bpfProgTypeMap {
+			candidates = append(candidates, progType)
+		}
+	}
+
+	// 4. Randomly select one from the final candidate pool.
+	randomIndex := r.Intn(len(candidates))
+	selectedProgType := candidates[randomIndex]
+
+	// 5. Return the ProgType numerical value of the selected struct.
+	return selectedProgType.ProgType, nil
+}
+
+func (r *randGen) patchBpfProgAttachTypesFields(c *Call, s *state, bpfProg *BpfProg) (changed bool) {
+	if r.patchConditionalDepth > 1 {
+		// Some nested patchConditionalFields() calls are fine as we could trigger a resource
+		// constructor via generateArg(). But since nested createResource() calls are prohibited,
+		// patchConditionalFields() should never be nested more than 2 times.
+		panic("third nested patchConditionalFields call")
+	}
+	r.patchConditionalDepth++
+	defer func() { r.patchConditionalDepth-- }()
+	var anyPatched bool
+	for {
+		replace := map[Arg]Arg{}
+		forEachStaleUnion(r.target, c,
+			func(unionArg *UnionArg, unionType *UnionType, okIndices []int) {
+				var idx int
+				var newTypeArg Arg
+				if unionType.String() == "bpf_prog_attach_types" {
+					idx = okIndices[0]
+				} else {
+					idx = okIndices[r.Intn(len(okIndices))]
+				}
+				newType, newDir := unionType.Fields[idx].Type,
+					unionType.Fields[idx].Dir(unionArg.Dir())
+				if unionType.String() == "bpf_prog_attach_types" {
+					newFlagsType := newType.(*FlagsType)
+					newFlagsTypeLen := len(newFlagsType.Vals)
+					RandomSelectFlagsTypeIndex := r.Intn(newFlagsTypeLen)
+					expectedAttachType := newFlagsType.Vals[RandomSelectFlagsTypeIndex]
+					newTypeArg = MakeConstArg(newFlagsType, newDir, expectedAttachType)
+					bpfProg.BpfProgContext.ExpectedAttachType = expectedAttachType
+					// fmt.Printf("Patch %s, prog_type=%d, expected_attach_type=%d, index:%d, from %v\n", newType.String(), bpfProg.BpfProgContext.ProgType, newTypeArg.(*ConstArg).Val, RandomSelectFlagsTypeIndex, newFlagsType.Vals)
+				} else {
+					newTypeArg, _ = r.generateArg(s, newType, newDir)
+				}
+				replace[unionArg] = MakeUnionArg(unionType, newDir, newTypeArg, idx)
+				anyPatched = true
+			})
+		for old, new := range replace {
+			replaceArg(old, new)
+		}
+		// The newly inserted argument might contain more arguments we need
+		// to patch.
+		// Repeat until we have to change nothing.
+		if len(replace) == 0 {
+			break
+		}
+	}
+	return anyPatched
+}
+
+func (Ldbf *LLMDrivenBPFuzzer) genLdbfProgLoadCall(r *randGen, s *state, bpfProg *BpfProg) (calls []*Call) {
+	meta := r.target.SyscallMap["bpf$LDBF_PROG_LOAD"]
+	// args := make([]Arg, len(meta.Args))
+
+	c := MakeCall(meta, nil)
+	c.Args, _ = r.generateArgs(s, meta.Args, DirIn)
+
+	BpfInsnByteCodeArray, err := ParseBpfRawInsnString(bpfProg.BpfRawInsnString)
+	if err != nil {
+		// fmt.Println("Error parsing data:", err)
+		return nil
+	}
+
+	BpfInsnByteCodeArray = ParseRawInsnAssignArgs(r, BpfInsnByteCodeArray)
+	ParseRawInsnReturnCode(r, BpfInsnByteCodeArray)
+
+	// Declare variables that will be used after goto
+	var ok bool
+	var cArgfield *PtrType
+	var bpfProgType *StructType
+	var cargfieldArg *PointerArg
+	var bpfProgTypeArg *GroupArg
+	var bpfProgTypeDir Dir
+	var selectProgTypeValue uint64
+	var bpfProgTypeIdx int
+	var bpfProgTypeFlag *FlagsType
+	var bpfProgTypeFlagArg Arg
+	var bpfInstructionsPtr *PtrType
+	var bpfInsnArrayArg Arg
+	var bpfInstructionsArg Arg
+	var bpfInstPtrArg Arg
+	var bpfInsnArray *ArrayType
+	var bpfInstructions *UnionType
+	var bpfProgTypeField Field
+	var bpfInsnIndex int
+	var bpfInstructionsPtrIdx int
+	var bpfInsnGenericInner []Arg
+
+	cArgfield, ok = c.Args[1].Type().(*PtrType)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: c.Args[1] is not a pointer type, got %T\n", c.Args[1].Type())
+		goto finish_gen
+	}
+
+	bpfProgType, ok = cArgfield.Elem.(*StructType)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: cArgfield.Elem is not a struct type, got %T\n", cArgfield.Elem)
+		goto finish_gen
+	}
+
+	cargfieldArg, ok = c.Args[1].(*PointerArg)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: c.Args[1] is not a PointerArg type, got %T\n", c.Args[1])
+		goto finish_gen
+	}
+	bpfProgTypeArg, ok = cargfieldArg.Res.(*GroupArg)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfProgLoadCall: cargfieldArg.Res is not a GroupArg type, got %T\n", cargfieldArg.Res)
+		goto finish_gen
+	}
+	bpfProgTypeDir = cArgfield.ElemDir
+
+	selectProgTypeValue, _ = RandomSelectProgType(r, bpfProg)
+	bpfProgTypeIdx = 0
+	bpfProgTypeFlag, ok = bpfProgType.Fields[bpfProgTypeIdx].Type.(*FlagsType)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfProgLoadCall: bpfProgType.Fields[%d] is not a flags type, got %T\n", bpfProgTypeIdx, bpfProgType.Fields[bpfProgTypeIdx].Type)
+		goto finish_gen
+	}
+	bpfProgTypeFlagArg = MakeConstArg(bpfProgTypeFlag, cArgfield.ElemDir, selectProgTypeValue)
+
+	for idx, field := range bpfProgType.Fields {
+		if field.String() != "ptr[in, bpf_instructions]" {
+			continue
+		}
+		bpfInstructionsPtrIdx = idx
+		bpfProgTypeField = field
+
+		bpfInstructionsPtr, ok = bpfProgTypeField.Type.(*PtrType)
+		if !ok {
+			// fmt.Printf("Ldbf: genLdbfProgLoadCall: bpfProgTypeField.Type is not a pointer type, got %T\n", bpfProgTypeField.Type)
+			goto finish_gen
+		}
+
+		bpfInstructions, ok = bpfInstructionsPtr.Elem.(*UnionType)
+		bpfInstructionsDir := bpfInstructionsPtr.ElemDir
+		if !ok {
+			// fmt.Printf("Ldbf: genLdbfProgLoadCall: bpfInstructionsPtr.Elem is not a union type, got %T\n", bpfInstructionsPtr.Elem)
+			goto finish_gen
+		}
+
+		bpfInsnIndex = 0
+		bpfinsnType := bpfInstructions.Fields[bpfInsnIndex].Type
+		bpfinsnDir := bpfInstructionsDir
+
+		bpfInsnArray, ok = bpfinsnType.(*ArrayType)
+		if !ok {
+			// fmt.Printf("Ldbf: genLdbfProgLoadCall: bpfInstructions.Fields[%d].Type is not an array type, got %T\n", bpfInsnIndex, bpfinsnType)
+			goto finish_gen
+		}
+
+		bpfInsn, ok := bpfInsnArray.Elem.(*UnionType)
+		if !ok {
+			// fmt.Printf("Ldbf: genLdbfProgLoadCall: bpfInsnArray.Elem is not a union type, got %T\n", bpfInsnArray.Elem)
+			goto finish_gen
+		}
+
+		// var count uint64 = 8
+		valueCount := 0
+		bpfInsnGenericInner = nil
+
+		bpfInsnGenericIndex := 0
+		bpfInsnGenericDir := bpfInsn.Fields[bpfInsnGenericIndex].Dir(bpfinsnDir)
+		bpfInsnGenericType := bpfInsn.Fields[bpfInsnGenericIndex].Type
+		bpfInsnGeneric, ok := bpfInsnGenericType.(*StructType)
+		if !ok {
+			// fmt.Printf("Ldbf: genLdbfProgLoadCall: bpfInsn.Fields[%d].Type is not a struct type, got %T\n", bpfInsnGenericIndex, bpfInsnGenericType)
+			goto finish_gen
+		}
+
+		bpfInsnMapFdIndex := 9
+		bpfInsnMapFdDir := bpfInsn.Fields[bpfInsnMapFdIndex].Dir(bpfinsnDir)
+		bpfInsnMapFdType := bpfInsn.Fields[bpfInsnMapFdIndex].Type
+		bpfInsnMapFd, ok := bpfInsnMapFdType.(*StructType)
+		if !ok {
+			// fmt.Printf("Ldbf: genLdbfProgLoadCall: bpfInsn.Fields[%d].Type is not a struct type, got %T\n", bpfInsnMapFdIndex, bpfInsnMapFdType)
+			goto finish_gen
+		}
+
+		for insnIndex := int(0); valueCount < len(BpfInsnByteCodeArray); insnIndex++ {
+			// handle BPF_LOAD_MAP_FD instruction
+			if _, ok := bpfProg.BpfMapResMap[insnIndex]; ok {
+				// fmt.Printf("Ldbf: genLdbfProgLoadCall: found BPF_LOAD_MAP_FD Insn, index %d\n", insnIndex)
+
+				bpfInsnMapFdArgs := make([]Arg, len(bpfInsnMapFd.Fields))
+				for bpfInsnMapFdFieldIdx, bpfInsnMapFdField := range bpfInsnMapFd.Fields {
+					if bpfInsnMapFdFieldInt, ok := bpfInsnMapFdField.Type.(*ConstType); ok {
+						bpfInsnMapFdArgs[bpfInsnMapFdFieldIdx] = MakeConstArg(bpfInsnMapFdFieldInt, bpfInsnMapFdDir, BpfInsnByteCodeArray[valueCount])
+					} else if bpfInsnMapFdFieldFlags, ok := bpfInsnMapFdField.Type.(*FlagsType); ok {
+						bpfInsnMapFdArgs[bpfInsnMapFdFieldIdx] = MakeConstArg(bpfInsnMapFdFieldFlags, bpfInsnMapFdDir, BpfInsnByteCodeArray[valueCount])
+					} else if bpfInsnMapFdFieldRes, ok := bpfInsnMapFdField.Type.(*ResourceType); ok {
+						bpfInsnMapFdArgs[bpfInsnMapFdFieldIdx] = MakeResultArg(bpfInsnMapFdFieldRes, bpfInsnMapFdDir, bpfProg.BpfMapResMap[insnIndex], 0)
+					}
+					valueCount++
+				}
+				valueCount++
+
+				bpfInsnMapFdGroup := MakeGroupArg(bpfInsnMapFd, bpfInsnMapFdDir, bpfInsnMapFdArgs)
+				bpfInsnArrayArg = MakeUnionArg(bpfInsn, bpfProgTypeField.Dir(DirIn), bpfInsnMapFdGroup, bpfInsnMapFdIndex)
+				bpfInsnGenericInner = append(bpfInsnGenericInner, bpfInsnArrayArg)
+			} else { // handle BPF_GENERIC_INSN instruction
+				bpfInsnGenericArgs := make([]Arg, len(bpfInsnGeneric.Fields))
+
+				for bpfInsnGenericFieldIdx, bpfInsnGenericField := range bpfInsnGeneric.Fields {
+					if bpfInsnGenericFieldInt, ok := bpfInsnGenericField.Type.(*IntType); ok {
+						if valueCount >= len(BpfInsnByteCodeArray) {
+							break
+						}
+						bpfInsnGenericArgs[bpfInsnGenericFieldIdx] = MakeConstArg(bpfInsnGenericFieldInt, bpfInsnGenericDir, BpfInsnByteCodeArray[valueCount])
+						valueCount++
+					}
+				}
+				bpfInsnGenericGroup := MakeGroupArg(bpfInsnGeneric, bpfInsnGenericDir, bpfInsnGenericArgs)
+				bpfInsnArrayArg = MakeUnionArg(bpfInsn, bpfProgTypeField.Dir(DirIn), bpfInsnGenericGroup, bpfInsnGenericIndex)
+				bpfInsnGenericInner = append(bpfInsnGenericInner, bpfInsnArrayArg)
+			}
+		}
+		break
+	}
+
+	if bpfInsnArray != nil && bpfInstructions != nil {
+		bpfInsnArrayArg = MakeGroupArg(bpfInsnArray, bpfProgTypeField.Dir(DirIn), bpfInsnGenericInner)
+		bpfInstructionsArg = MakeUnionArg(bpfInstructions, bpfProgTypeField.Dir(DirIn), bpfInsnArrayArg, bpfInsnIndex)
+		bpfInstPtrArg = r.allocAddr(s, bpfInstructionsPtr, bpfProgTypeField.Dir(DirIn), bpfInstructionsArg.Size(), bpfInstructionsArg)
+		fmt.Printf("Ldbf: GenLdbfPrologue: BpfProgFilePath: %s, old bpfProgType is %v, selectProgTypeValue is %v\n\n",
+			bpfProg.BpfProgFilePath, bpfProgTypeArg.Inner[bpfProgTypeIdx].(*ConstArg).Val, selectProgTypeValue)
+		replaceArg(bpfProgTypeArg.Inner[bpfProgTypeIdx], bpfProgTypeFlagArg)
+		replaceArg(bpfProgTypeArg.Inner[bpfInstructionsPtrIdx], bpfInstPtrArg)
+	}
+
+	bpfProg.BpfProgContext.ProgType = selectProgTypeValue
+
+	for bpfProgTypeIdx, bpfProgTypeField := range bpfProgType.Fields {
+		if bpfProgTypeIdx < 2 {
+			continue
+		}
+		var newArg Arg
+		bpfProgTypeFieldDir := bpfProgTypeField.Dir(bpfProgTypeDir)
+		switch bpfProgTypeIdx {
+		case 3: // license
+			licensePtrElemDir := bpfProgTypeField.Type.(*PtrType).ElemDir
+			licensePtrElem := bpfProgTypeField.Type.(*PtrType).Elem.(*BufferType)
+			inner := MakeDataArg(licensePtrElem, licensePtrElemDir, append([]byte("GPL"), 0))
+			newArg = r.allocAddr(s, bpfProgTypeField.Type, bpfProgTypeFieldDir, inner.Size(), inner)
+
+		case 4: // loglev, log_size, [0, 15]
+			newArg = MakeConstArg(bpfProgTypeField.Type, bpfProgTypeFieldDir, 0)
+		// case 5, 15, 18, 21: // LenType, just skip
+		case 6, 14, 17, 22, 23: // PtrType; func_info, func_info_cnt，line_info, line_info_cnt should be set to 0
+			newArg = MakeSpecialPointerArg(bpfProgTypeField.Type, bpfProgTypeFieldDir, 0)
+
+		case 7, 13, 16, 24, 25: // IntType, FlagsType, ConstType, ProcType, CsumType
+			newArg = MakeConstArg(bpfProgTypeField.Type, bpfProgTypeFieldDir, 0)
+
+		case 8: // flags
+			newArg = MakeConstArg(bpfProgTypeField.Type, bpfProgTypeFieldDir, uint64(selectProgLoadFlags(selectProgTypeValue)))
+			//newArg = MakeConstArg(bpfProgTypeField.Type, bpfProgTypeFieldDir, 0)
+		case 9: // BufferType
+			//newArg = MakeDataArg(bpfProgTypeField.Type, bpfProgTypeFieldDir, nil)
+
+		case 10, 12, 20: // ResourceType
+			newArg = MakeResultArg(bpfProgTypeField.Type, bpfProgTypeFieldDir, nil, 0)
+
+		case 19: // attach_btf_id
+			attach_btf_id := uint64(0)
+			if selectProgTypeValue == BPF_PROG_TYPE_LSM ||
+				selectProgTypeValue == BPF_PROG_TYPE_TRACING ||
+				selectProgTypeValue == BPF_PROG_TYPE_EXT {
+				attach_btf_id = uint64(getRandomBtfid())
+				// linux 6.6 bpf_lsm_file_mprotect 227982
+			}
+			newArg = MakeResultArg(bpfProgTypeField.Type, bpfProgTypeFieldDir, nil, attach_btf_id)
+			// case 11, 26, 27: // UnionType, todo
+		}
+		if newArg != nil {
+			replaceArg(bpfProgTypeArg.Inner[bpfProgTypeIdx], newArg)
+		}
+	}
+
+finish_gen:
+	r.patchBpfProgAttachTypesFields(c, s, bpfProg)
+	r.target.assignSizesCall(c)
+	var currentBpfMapCall []*Call
+	return append(currentBpfMapCall, c)
+}
