+var LdbfBtfIdMap = make(map[string]int)
+
+func getBtfidFromVmlinux(vmlinuxPath string, funcName string) int {
+	var btfidRegex = regexp.MustCompile(`\[(.*?)\]`)
+	cmd := fmt.Sprintf("bpftool btf dump file %s | grep %s", vmlinuxPath, funcName)
+	execResult := exec.Command("bash", "-c", cmd)
+	output, err := execResult.CombinedOutput()
+	if err != nil {
+		// fmt.Printf("Error executing command: %v\n", err)
+		return -1
+	}
+	// fmt.Printf("Command output: %s\n", output)
+	matches := btfidRegex.FindStringSubmatch(string(output))
+	//fmt.Println(matches)
+	if len(matches) < 2 {
+		// fmt.Printf("No match found in output: %s\n", output)
+		return -1
+	}
+	// fmt.Printf("Matched string: %s\n", matches[1])
+	var btfid int
+	_, err = fmt.Sscanf(matches[1], "%d", &btfid)
+	if err != nil {
+		// fmt.Printf("Error parsing btfid: %v\n", err)
+		return -1
+	}
+	return btfid
+
+}
+
+func initBtfMap() {
+	vmlinuxPath := os.Getenv("LDBF_VMLINUX_PATH")
+	if vmlinuxPath == "" {
+		fmt.Println("Warning: LDBF_VMLINUX_PATH is not set. Skipping BTF ID initialization.")
+		panic("LDBF_VMLINUX_PATH is required for BTF ID initialization.")
+	}
+	for _, btfFunc := range BtfAttachFuncs {
+		id := getBtfidFromVmlinux(vmlinuxPath, btfFunc)
+		LdbfBtfIdMap[btfFunc] = id
+	}
+
+}
+
+func getRandomBtfid() int {
+	btfid := 0
+	length := len(BtfAttachFuncs)
+	circles := 0
+	for btfid <= 0 {
+		randomIndex := rand.Intn(length)
+		btfFunc := BtfAttachFuncs[randomIndex]
+		btfid = LdbfBtfIdMap[btfFunc]
+		circles += 1
+		if circles >= 3 {
+			return 0
+		}
+	}
+	// fmt.Printf("getRandomBtfid: selected BTF ID %d\n", btfid)
+	return btfid
+}
