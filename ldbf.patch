+	// From the kernel source `bpf_prog_test_run_sk_lookup`:
+	// - `flags`, `cpu`, and `batch_size` must be zero.
+	// - `data_in/out` must be NULL.
+	return BpfProgTestRunStruct{
+		ProgFD: bpfProg.BpfProgContext.ProgFD,
+
+		DataSizeIn:  0,
+		DataSizeOut: 0,
+		DataIn:      nil,
+		DataOut:     nil,
+
+		Repeat:   uint32(r.Intn(REPEAT_TIMES)),
+		Duration: uint32(r.Intn(REPEAT_TIMES)),
+
+		CtxSizeIn:  ctxSizeIn,
+		CtxSizeOut: uint32(len(ctxOut)),
