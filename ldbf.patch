+	BPF_NETKIT_PRIMARY                 int = 0x36
+	BPF_NETKIT_PEER                    int = 0x37
+	BPF_TRACE_KPROBE_SESSION           int = 0x38
+	BPF_TRACE_UPROBE_SESSION           int = 0x39
