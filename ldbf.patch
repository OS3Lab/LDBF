+const (
+	IntIdx    = 0
+	PtrIdx    = 1
+	ArrayIdx  = 2
+	StructIdx = 3
+	UnionIdx  = 4
+	EnumIdx   = 5
+	FuncIdx   = 11
+	FloatIdx  = 15
