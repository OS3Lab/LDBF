+// NewValidBpfFlowKeysForTestRun creates a valid `bpf_flow_keys` context.
+// According to `verify_user_bpf_flow_keys`, all fields except `flags` must be zero.
+func NewValidBpfFlowKeysForTestRun(r *randGen) []byte {
+	flowKeys := &BpfFlowKeys{
+		Flags: r.Uint32(),
+	}
+	size := unsafe.Sizeof(*flowKeys)
+	data := make([]byte, size)
+	keysBytesView := (*[1 << 30]byte)(unsafe.Pointer(flowKeys))[:size:size]
+	copy(data, keysBytesView)
+	return data
+}
