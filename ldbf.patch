+// TODO: This function should be improved to create a valid context
+// PatchBpfStructOpsTestRun constructs valid parameters for a struct_ops program.
+func PatchBpfStructOpsTestRun(r *randGen, bpfProg *BpfProg) BpfProgTestRunStruct {
+	// From `dummy_ops_init_args`, `ctx_size_in` must be a multiple of 8.
+	// We generate a random number of arguments between 1 and 10.
+	numArgs := r.Intn(MAX_BPF_FUNC_ARGS + 3)
+	ctxSizeIn := uint32(numArgs * 8)
+	var ctxIn []byte
+	if r.Intn(2) == 0 {
+		ctxIn = make([]byte, ctxSizeIn)
+		for i := range ctxIn {
+			ctxIn[i] = byte(r.Intn(256))
+		}
+	} else {
+		ctxIn = nil
+	}
+
+	// The kernel copies arguments back, so provide an output buffer.
+	ctxOut := make([]byte, ctxSizeIn)
+
+	dataSizeIn := uint32(r.Intn(65536))
+	dataIn := make([]byte, dataSizeIn)
+	for i := range dataIn {
+		dataIn[i] = byte(r.Intn(256))
+	}
+
+	dataOut := make([]byte, dataSizeIn)
+	for i := range dataOut {
+		dataOut[i] = byte(r.Intn(256))
+	}
+
+	// bpf_struct_ops_test_run doesn't check other fields, just random them.
+	return BpfProgTestRunStruct{
+		ProgFD: bpfProg.BpfProgContext.ProgFD,
+
+		DataSizeIn:  dataSizeIn,
+		DataSizeOut: uint32(len(dataOut)),
+		DataIn:      dataIn,
+		DataOut:     dataOut,
+
+		Repeat:   uint32(r.Intn(REPEAT_TIMES)),
+		Duration: uint32(r.Intn(REPEAT_TIMES)),
+
+		CtxSizeIn:  ctxSizeIn,
+		CtxSizeOut: uint32(len(ctxOut)),
+		CtxIn:      ctxIn,
+		CtxOut:     ctxOut,
+
+		Flags:     r.Uint32(),
+		Cpu:       uint32(r.Intn(MAX_CPUS)),
+		BatchSize: r.Uint32(),
+	}
+}
