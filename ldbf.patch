+func selectProgLoadFlags(progType uint64) uint32 {
+	var flags uint32 = 0
+
+	if progType == BPF_PROG_TYPE_SYSCALL {
+		flags |= BPF_F_SLEEPABLE
+	}
+
+	if rand.Intn(100) < 20 {
+		flag_list := []uint32{BPF_F_STRICT_ALIGNMENT, BPF_F_ANY_ALIGNMENT, BPF_F_TEST_RND_HI32, BPF_F_TEST_STATE_FREQ, BPF_F_XDP_HAS_FRAGS, BPF_F_XDP_DEV_BOUND_ONLY}
+		times := rand.Intn(5) + 1
+		for i := 0; i < times; i++ {
+			flags |= flag_list[rand.Intn(len(flag_list))]
+		}
+	}
+
+	return flags
+
+}
