+
+func genBTFMessage() BtfMessage {
+	var typesSlice [][]uint64
+	var btfMsg BtfMessage
+	btfMsg.key_size = 4
+	btfMsg.value_size = 4
+	btfMsg.key_id = 1
+	btfMsg.value_id = 1
+	typesSlice = append(typesSlice, []uint64{0, 0, 0, 1, 4, 32, 0, 0, 1}) // int a
+	typesSlice = append(typesSlice, []uint64{1, 0, 0, 16, 8})             // float b
+	//typesSlice = append(typesSlice, []uint64{3, 0, 0, 12, 2})
+	btfMsg.typesSlice = typesSlice
