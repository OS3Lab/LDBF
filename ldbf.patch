+func (Ldbf *LLMDrivenBPFuzzer) genLdbfBtfLoadCall(r *randGen, s *state, bpfProg *BpfProg) []*Call {
+	// var btfHeaderStrlenIdx   int
+	// var btfHeaderStroffIdx   int
+	//var btfHeaderTypelenIdx  int
+	var btfHeaderTypesIdx int
+	var btfTypesArray []Arg
