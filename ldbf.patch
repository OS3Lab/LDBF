+func (Ldbf *LLMDrivenBPFuzzer) genLdbfProgTestRunCall(r *randGen, s *state, bpfProg *BpfProg) (calls []*Call) {
+	meta := r.target.SyscallMap["bpf$LDBF_BPF_PROG_TEST_RUN"]
+	args := make([]Arg, len(meta.Args))
+	c := MakeCall(meta, nil)
+
+	ProgTestRunContext, supported := SetupProgTestRunContext(r, bpfProg)
+	if !supported {
+		return calls
+	}
+
+	cmdArg := meta.Args[0]
+	args[0], _ = r.generateArg(s, cmdArg.Type, cmdArg.Dir(DirIn))
+
+	testProgArg := meta.Args[1]
+	testProgPtr := testProgArg.Type.(*PtrType)
+	testProgStruct := testProgPtr.Elem.(*StructType)
+	testProgStructDir := testProgPtr.ElemDir
+
+	testProgStructFields := make([]Arg, len(testProgStruct.Fields))
+	for testProgStructFieldIdx, testProgStructField := range testProgStruct.Fields {
+		var newArg Arg
+		bpfProgTypeFieldDir := testProgStructField.Dir(testProgStructDir)
+		switch testProgStructFieldIdx {
+		case 0: // prog_fd, ResourceType
+			newArg = MakeResultArg(testProgStructField.Type, bpfProgTypeFieldDir, ProgTestRunContext.ProgFD, 0)
+		case 1: // retval
+		case 2: // data_size_in
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.DataSizeIn))
+		case 3: // data_size_out
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.DataSizeOut))
+		case 4: // data_in
+			dataInBuffer := testProgStructField.Type.(*PtrType).Elem.(*BufferType)
+			dataInBufferDir := testProgStructField.Type.(*PtrType).ElemDir
+			inner := MakeDataArg(dataInBuffer, dataInBufferDir, ProgTestRunContext.DataIn)
+			newArg = r.allocAddr(s, testProgStructField.Type, bpfProgTypeFieldDir, inner.Size(), inner)
+		case 5: // data_out
+			dataOutBuffer := testProgStructField.Type.(*PtrType).Elem.(*BufferType)
+			dataOutBufferDir := testProgStructField.Type.(*PtrType).ElemDir
+			inner := MakeOutDataArg(dataOutBuffer, dataOutBufferDir, uint64(len(ProgTestRunContext.DataOut)))
+			newArg = r.allocAddr(s, testProgStructField.Type, bpfProgTypeFieldDir, inner.Size(), inner)
+		case 6: // repeat, IntType
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.Repeat))
+		case 7: // duration, ConstType
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.Duration))
+		case 8: // ctx_size_in
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.CtxSizeIn))
+		case 9: // ctx_size_out
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.CtxSizeOut))
+		case 10: // ctx_in
+			ctxInBuffer := testProgStructField.Type.(*PtrType).Elem.(*BufferType)
+			ctxInBufferDir := testProgStructField.Type.(*PtrType).ElemDir
+			inner := MakeDataArg(ctxInBuffer, ctxInBufferDir, ProgTestRunContext.CtxIn)
+			newArg = r.allocAddr(s, testProgStructField.Type, bpfProgTypeFieldDir, inner.Size(), inner)
+		case 11: // ctx_out
+			ctxOutBuffer := testProgStructField.Type.(*PtrType).Elem.(*BufferType)
+			ctxOutBufferDir := testProgStructField.Type.(*PtrType).ElemDir
+			inner := MakeDataArg(ctxOutBuffer, ctxOutBufferDir, ProgTestRunContext.CtxOut)
+			newArg = r.allocAddr(s, testProgStructField.Type, bpfProgTypeFieldDir, inner.Size(), inner)
+		case 12: // flags, FlagsType
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.Flags))
+		case 13: // cpu, ConstType
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.Cpu))
+		case 14: // batch_size, IntType
+			newArg = MakeConstArg(testProgStructField.Type, bpfProgTypeFieldDir, uint64(ProgTestRunContext.BatchSize))
+		}
+		if newArg != nil {
+			testProgStructFields[testProgStructFieldIdx] = newArg
+		} else {
+			testProgStructFields[testProgStructFieldIdx], _ = r.generateArg(s, testProgStructField.Type, testProgStructField.Dir(DirIn))
+		}
+	}
+
+	testProgStructArg := MakeGroupArg(testProgStruct, testProgStructDir, testProgStructFields)
+	args[1] = r.allocAddr(s, testProgArg.Type, testProgArg.Dir(DirIn), testProgStructArg.Size(), testProgStructArg)
+
+	lenArg := meta.Args[2]
+	args[2], _ = r.generateArg(s, lenArg.Type, lenArg.Dir(DirIn))
+
+	c.Args = args
+	// moreCalls, _ := r.patchConditionalFields(c, s)
+	// r.target.assignSizesCall(c)
+	// return append(append(calls, moreCalls...), c)
+
+	r.target.assignSizesCall(c)
+
+	var currentBpfMapCall []*Call
+	return append(currentBpfMapCall, c)
+}
