+func TranslateBpfProg(bpfProg *BpfProg) *BpfProg {
+	LDBFDir := os.Getenv("LDBF_DIR") + "/"
+	if LDBFDir == "/" {
+		panic("LDBF_DIR environment variable is not set")
+	}
+
+	if bpfProg.PythonPath == "" {
+		// fmt.Println("Uninitialized PythonPath")
+		return bpfProg
+	}
+
+	BpfRawInsnFilePath := bpfProg.BpfProgFilePath + ".json"
+
+	var stdoutBuf bytes.Buffer
+	var stderrBuf bytes.Buffer
+	cmd := exec.Command(bpfProg.PythonPath,
+		LDBFDir+"translator/translate.py",
+		bpfProg.BpfProgFilePath,
+		BpfRawInsnFilePath)
+
+	cmd.Stdout = &stdoutBuf
+	cmd.Stderr = &stderrBuf
+
+	err := cmd.Run()
+
+	if err != nil && os.Getenv("LDBF_DEBUG_BPF_INSN") != "" {
+		bpfProg.BpfRawInsnFilePath = ""
+		return bpfProg
+	}
+
+	bpfProg.BpfRawInsnFilePath = BpfRawInsnFilePath
+	// fmt.Printf("\tTranslated File Path: %s\n", BpfRawInsnFilePath)
+
+	return bpfProg
+}
+
+func ExtractBpfRawInsn(filename string) (string, error) {
+	jsonDataBytes, err := os.ReadFile(filename)
+	if err != nil {
+		return "", fmt.Errorf("error reading file '%s': %w", filename, err)
+	}
+
+	var data map[string]interface{}
+	err = json.Unmarshal(jsonDataBytes, &data)
+	if err != nil {
+		return "", fmt.Errorf("error unmarshalling JSON from '%s': %w", filename, err)
+	}
+
+	bpfRawInsnInterface, found := data["bpf_insn"]
+	if !found {
+		return "", fmt.Errorf("key 'bpf_insn' not found in JSON file '%s'", filename)
+	}
+
+	BpfRawInsnString, ok := bpfRawInsnInterface.(string)
+	if !ok {
+		return "", fmt.Errorf("value for key 'bpf_insn' in '%s' is not a string (type: %T)", filename, bpfRawInsnInterface)
+	}
+
+	return BpfRawInsnString, nil
+}
+
+func FillExtractBpfRawInsn(bpfProg *BpfProg) *BpfProg {
+	BpfRawInsnString, err := ExtractBpfRawInsn(bpfProg.BpfRawInsnFilePath)
+
+	if err != nil {
+		// fmt.Printf("Error extracting BPF instructions: %v\n", err)
+		bpfProg.BpfRawInsnString = ""
+		return bpfProg
+	}
+
+	bpfProg.BpfRawInsnString = BpfRawInsnString
+	return bpfProg
+}
+
+func JoinLdbfLoraDir(suffix string) (string, error) {
+	execuatedDir := os.Getenv("LDBF_LORA_DIR")
+	if execuatedDir == "" {
+		// fmt.Println("Warning: LDBF_LORA_DIR environment variable is not set. Falling back to LDBF_DIR.")
+		ldbfDir := os.Getenv("LDBF_DIR")
+		execuatedDir = filepath.Join(ldbfDir, "generate-seeds")
+	}
+
+	finalDir := filepath.Join(execuatedDir, suffix)
+	if err := os.MkdirAll(finalDir, 0755); err != nil {
+		return "", fmt.Errorf("failed to create execuated directory '%s': %w", finalDir, err)
+	}
+	return finalDir, nil
+}
+
+func GetExecuatedDir() (string, error) {
+	return JoinLdbfLoraDir("execuated")
+}
+
+func (LDBF *LLMDrivenBPFuzzer) CheckBpfProgExecuated(bpfProg *BpfProg) (bool, error) {
+	finalDir, err := GetExecuatedDir()
+	if err != nil {
+		return false, err
+	}
+	destPath := filepath.Join(finalDir, filepath.Base(bpfProg.BpfProgFilePath))
+	_, err = os.Stat(destPath)
+	if os.IsNotExist(err) {
+		return false, nil
+	} else if err != nil {
+		return false, fmt.Errorf("failed to check file '%s': %w", destPath, err)
+	}
+	return true, nil
+}
+
+func (LDBF *LLMDrivenBPFuzzer) MarkBpfProgAsExecuated(bpfProg *BpfProg) (bool, error) {
+	finalDir, err := GetExecuatedDir()
+	if err != nil {
+		return false, err
+	}
+	destPath := filepath.Join(finalDir, filepath.Base(bpfProg.BpfProgFilePath))
+	err = os.Symlink(bpfProg.BpfProgFilePath, destPath)
+	if err != nil {
+		return false, fmt.Errorf("failed to create symlink from '%s' to '%s': %w", bpfProg.BpfProgFilePath, destPath, err)
+	}
+	return true, nil
+}
