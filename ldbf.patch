+// PatchBpfProgTestRunSyscall constructs valid parameters for a syscall program.
+func PatchBpfProgTestRunSyscall(r *randGen, bpfProg *BpfProg) BpfProgTestRunStruct {
+	// From `bpf_prog_test_run_syscall`, `ctx_size_in` must be <= U16_MAX.
+	// We ignore the lower bound `prog->aux->max_ctx_offset` for generation.
+	ctxSizeIn := uint32(r.Intn(1 << 16))
+	var ctxIn []byte
+	if ctxSizeIn > 0 {
+		ctxIn = make([]byte, ctxSizeIn)
+		for i := range ctxIn {
+			ctxIn[i] = byte(r.Intn(256))
+		}
+	}
+
+	// From the kernel source, this test run type is very restrictive.
+	// It doesn't support data_in/out, ctx_out, duration, repeat, or flags.
+	return BpfProgTestRunStruct{
+		ProgFD: bpfProg.BpfProgContext.ProgFD,
+
+		DataSizeIn:  0,
+		DataSizeOut: 0,
+		DataIn:      nil,
+		DataOut:     nil,
+
+		Repeat:   0,
+		Duration: 0,
+
+		CtxSizeIn:  ctxSizeIn,
+		CtxSizeOut: 0,
+		CtxIn:      ctxIn,
+		CtxOut:     nil,
+
+		Flags:     0,
+		Cpu:       uint32(r.Intn(MAX_CPUS)), // The cpu field is not used.
+		BatchSize: 0,
+	}
+}
