+	FlowKeys       uint64 // Represents __bpf_md_ptr(struct bpf_flow_keys *, flow_keys)
+	Tstamp         uint64
+	WireLen        uint32
+	GsoSegs        uint32
+	Sk             uint64 // Represents __bpf_md_ptr(struct bpf_sock *, sk)
+	GsoSize        uint32
+	TstampType     uint8
+	Padding        [3]byte // Padding, future use
+	Hwtstamp       uint64
+}
+
+const (
+	// Minimum value of data_size_in
+	ETH_HLEN = 14
+
+	// MAX_Data_SIZE_IN is a safe upper bound for data_size_in.
+	// The kernel checks `size > 4096 - headroom - tailroom`.
+	MAX_Data_SIZE_IN = 4096
+
+	// Ethernet header align len.
+	ETH_ALEN = 6
+
+	// Internet Protocol packet.
+	ETH_P_IP = 0x0800
+	// IPv6 over bluebook.
+	ETH_P_IPV6 = 0x86DD
+
+	// Maximum interface index.
+	MAX_IF_INDEX = 32
+
+	// Repeat times
+	REPEAT_TIMES = 10
+
+	// BPF_F_TEST_XDP_LIVE_FRAMES is the flag for do_live mode.
+	BPF_F_TEST_XDP_LIVE_FRAMES = 1
+
+	// TEST_XDP_MAX_BATCH defines the maximum batch size for live mode.
+	TEST_XDP_MAX_BATCH = 256
+
+	// Maximum cpus.
+	MAX_CPUS = 4
+
+	// BPF_F_TEST_RUN_ON_CPU is the flag to run the test on a specific CPU.
+	BPF_F_TEST_RUN_ON_CPU = 1
+
+	// MAX_BPF_FUNC_ARGS defines the maximum number of arguments for a BPF raw tracepoint.
+	MAX_BPF_FUNC_ARGS = 12
+
+	// Address families.
+	AF_INET  = 2
+	AF_INET6 = 10
+
+	// Maximum values for port.
+	U16_MAX = 65535
+
+	// Maximum protocol number.
+	IPPROTO_MAX = 263
+
+	// netfilter protocol families.
+	NFPROTO_IPV4 = 2
+	NFPROTO_IPV6 = 10
+
+	// netfilter hook points.
+	NF_INET_PRE_ROUTING  = 0
+	NF_INET_LOCAL_IN     = 1
+	NF_INET_FORWARD      = 2
+	NF_INET_LOCAL_OUT    = 3
+	NF_INET_POST_ROUTING = 4
+	NF_INET_NUMHOOKS     = 5
+	NF_INET_INGRESS      = NF_INET_NUMHOOKS
+
+	// Sizes of IP headers.
+	SIZE_OF_IPHDR   = 20
+	SIZE_OF_IPV6HDR = 40
+
+	// Ratio of forging a valid packet data
+	PACKET_FORGE_RATE = 0.8
+)
+
+// NewValidSkBuffForTestRun creates a byte representation of a SkBuff struct,
+// constructed to pass the checks in the kernel's convert___skb_to_skb function.
+// It randomizes allowed fields and returns a safe, independent byte slice.
+func NewValidSkBuffForTestRun(r *randGen) []byte {
+	// 1. Create a pointer to a SkBuff struct. Go initializes all fields to zero.
+	skb := &SkBuff{}
+
+	// 2. Randomize only the fields that are explicitly allowed to be non-zero.
+	skb.Mark = r.Uint32()
+	skb.Priority = r.Uint32()
+	skb.IngressIfindex = r.Uint32()
+	skb.Ifindex = uint32(r.Intn(MAX_IF_INDEX))
+	for i := range skb.Cb {
+		skb.Cb[i] = r.Uint32()
+	}
+	skb.Tstamp = r.Uint64()
+	// wire_len is kept at 0 to safely pass kernel checks.
+	skb.WireLen = 0
+	// gso_segs is randomized to a small value to avoid exceeding kernel limits.
+	skb.GsoSegs = uint32(r.Intn(65536))
+	skb.GsoSize = r.Uint32()
+	skb.Hwtstamp = r.Uint64()
+
+	// 3. Get the total size of the struct in memory.
+	size := unsafe.Sizeof(*skb)
+
+	// 4. Create a new, independent byte slice of the exact same size.
+	// This is the safe `make` allocation.
+	data := make([]byte, size)
+
+	// 5. Create a temporary unsafe view of the struct's memory.
+	skbBytesView := (*[1 << 30]byte)(unsafe.Pointer(skb))[:size:size]
+
+	// 6. Copy the content from the struct's memory view into the new slice.
+	copy(data, skbBytesView)
+
+	// 7. Return the new, safe, and independent data slice.
+	return data
+}
+
+type EthHdr struct {
+	HDest   [ETH_ALEN]byte
+	HSource [ETH_ALEN]byte
+	HProto  uint16 // Stored in network byte order (Big Endian)
+}
+
+type IpHdr struct {
+	VersionIHL uint8 // 4 bits for Version, 4 bits for IHL
+	Tos        uint8
+	TotLen     uint16 // Stored in network byte order (Big Endian)
+	Id         uint16 // Stored in network byte order (Big Endian)
+	FragOff    uint16 // Stored in network byte order (Big Endian)
+	TTL        uint8
+	Protocol   uint8
+	Check      uint16 // Stored in network byte order (Big Endian)
+	Saddr      uint32 // Stored in network byte order (Big Endian)
+	Daddr      uint32 // Stored in network byte order (Big Endian)
+}
+
+type Ipv6Hdr struct {
+	VersionPriority uint8 // 4 bits version, 4 bits priority
+	FlowLabel       [3]byte
+	PayloadLen      uint16
+	NextHdr         uint8
+	HopLimit        uint8
+	Saddr           [16]byte
+	Daddr           [16]byte
+}
+
+// NewValidSkBuffPacketData constructs a structured, valid network packet as a byte slice
+func NewValidSkBuffPacketData(r *randGen) []byte {
+	// 1. Populate the common Ethernet header struct.
+	eth := &EthHdr{}
+	// Populate the struct fields with valid and random data.
+	// Populate Ethernet Header
+	for i := range eth.HDest {
+		eth.HDest[i] = byte(r.Intn(256))
+	}
+	for i := range eth.HSource {
+		eth.HSource[i] = byte(r.Intn(256))
+	}
+
+	var dataIn []byte
+	var dataSizeIn int
+
+	// 2. Randomly choose to create either an IPv4 or IPv6 packet.
+	if r.bin() {
+		// --- Generate IPv4 Packet ---
+		eth.HProto = ETH_P_IP
+
+		minSize := ETH_HLEN + SIZE_OF_IPHDR
+		dataSizeIn = minSize + r.Intn(MAX_Data_SIZE_IN)
+		dataIn = make([]byte, dataSizeIn)
+
+		ip := &IpHdr{
+			VersionIHL: (4 << 4) | uint8(r.Intn(16)), // Version 4, Header Length 5 (20 bytes)
+			Tos:        uint8(r.Intn(256)),
+			TotLen:     uint16(dataSizeIn - ETH_HLEN),
+			Id:         uint16(r.Intn(65536)),
+			FragOff:    uint16(r.Intn(65536)),
+			TTL:        uint8(r.Intn(256)),
+			Protocol:   uint8(r.Intn(256)),
+			Check:      uint16(r.Intn(65536)),
+			Saddr:      r.Uint32(),
+			Daddr:      r.Uint32(),
+		}
+
+		// Serialize Ethernet and IPv4 headers
+		copy(dataIn[int(unsafe.Offsetof(eth.HDest)):], eth.HDest[:])
+		copy(dataIn[int(unsafe.Offsetof(eth.HSource)):], eth.HSource[:])
+		binary.BigEndian.PutUint16(dataIn[int(unsafe.Offsetof(eth.HProto)):], eth.HProto)
+
+		ipOffset := ETH_HLEN
+		dataIn[ipOffset+int(unsafe.Offsetof(ip.VersionIHL))] = ip.VersionIHL
+		dataIn[ipOffset+int(unsafe.Offsetof(ip.Tos))] = ip.Tos
+		binary.BigEndian.PutUint16(dataIn[ipOffset+int(unsafe.Offsetof(ip.TotLen)):], ip.TotLen)
+		binary.BigEndian.PutUint16(dataIn[ipOffset+int(unsafe.Offsetof(ip.Id)):], ip.Id)
+		binary.BigEndian.PutUint16(dataIn[ipOffset+int(unsafe.Offsetof(ip.FragOff)):], ip.FragOff)
+		dataIn[ipOffset+int(unsafe.Offsetof(ip.TTL))] = ip.TTL
+		dataIn[ipOffset+int(unsafe.Offsetof(ip.Protocol))] = ip.Protocol
+		binary.BigEndian.PutUint16(dataIn[ipOffset+int(unsafe.Offsetof(ip.Check)):], ip.Check)
+		binary.BigEndian.PutUint32(dataIn[ipOffset+int(unsafe.Offsetof(ip.Saddr)):], ip.Saddr)
+		binary.BigEndian.PutUint32(dataIn[ipOffset+int(unsafe.Offsetof(ip.Daddr)):], ip.Daddr)
+
+		// Fill payload with random data
+		for i := int(ETH_HLEN + SIZE_OF_IPHDR); i < dataSizeIn; i++ {
+			dataIn[i] = byte(r.Intn(256))
+		}
+
+	} else {
+		// --- Generate IPv6 Packet ---
+		eth.HProto = ETH_P_IPV6
+
+		minSize := ETH_HLEN + SIZE_OF_IPV6HDR
+		dataSizeIn = minSize + r.Intn(MAX_Data_SIZE_IN)
+		dataIn = make([]byte, dataSizeIn)
+
+		ipv6 := &Ipv6Hdr{
+			VersionPriority: (6 << 4) | uint8(r.Intn(16)), // Version 6, Priority 0
+			PayloadLen:      uint16(dataSizeIn - ETH_HLEN - SIZE_OF_IPV6HDR),
+			NextHdr:         uint8(r.Intn(256)),
+			HopLimit:        uint8(r.Intn(256)),
+		}
+		for i := range ipv6.FlowLabel {
+			ipv6.FlowLabel[i] = byte(r.Intn(256))
+		}
+		for i := range ipv6.Saddr {
+			ipv6.Saddr[i] = byte(r.Intn(256))
+		}
+		for i := range ipv6.Daddr {
+			ipv6.Daddr[i] = byte(r.Intn(256))
+		}
+
+		// Serialize Ethernet and IPv6 headers
+		copy(dataIn[int(unsafe.Offsetof(eth.HDest)):], eth.HDest[:])
+		copy(dataIn[int(unsafe.Offsetof(eth.HSource)):], eth.HSource[:])
+		binary.BigEndian.PutUint16(dataIn[int(unsafe.Offsetof(eth.HProto)):], eth.HProto)
+
+		ipOffset := ETH_HLEN
+		dataIn[ipOffset+int(unsafe.Offsetof(ipv6.VersionPriority))] = ipv6.VersionPriority
+		copy(dataIn[ipOffset+int(unsafe.Offsetof(ipv6.FlowLabel)):], ipv6.FlowLabel[:])
+		binary.BigEndian.PutUint16(dataIn[ipOffset+int(unsafe.Offsetof(ipv6.PayloadLen)):], ipv6.PayloadLen)
+		dataIn[ipOffset+int(unsafe.Offsetof(ipv6.NextHdr))] = ipv6.NextHdr
+		dataIn[ipOffset+int(unsafe.Offsetof(ipv6.HopLimit))] = ipv6.HopLimit
+		copy(dataIn[ipOffset+int(unsafe.Offsetof(ipv6.Saddr)):], ipv6.Saddr[:])
+		copy(dataIn[ipOffset+int(unsafe.Offsetof(ipv6.Daddr)):], ipv6.Daddr[:])
+
+		// Fill payload with random data
+		for i := int(ETH_HLEN + SIZE_OF_IPV6HDR); i < dataSizeIn; i++ {
+			dataIn[i] = byte(r.Intn(256))
+		}
+	}
+
+	return dataIn
+}
+
+// PatchBpfProgTestRunSkb constructs valid parameters for bpf_prog_test_run_skb
+// command targeting a BPF program that expects a __sk_buff context.
+func PatchBpfProgTestRunSkb(r *randGen, bpfProg *BpfProg) BpfProgTestRunStruct {
+	var dataSizeIn int
+	var dataIn []byte
+
+	if r.Float64() > PACKET_FORGE_RATE {
+		// Create random input data.
+		dataSizeIn = ETH_HLEN + r.Intn(MAX_Data_SIZE_IN)
+		dataIn = make([]byte, dataSizeIn)
+		for i := range dataIn {
+			dataIn[i] = byte(r.Intn(256))
+		}
+	} else {
+		// Create structured, valid packet data.
+		dataIn = NewValidSkBuffPacketData(r)
+		dataSizeIn = len(dataIn)
+	}
+	// fmt.Printf("BpfProgFilePath:%s, skb packet data of size %d bytes:\n", bpfProg.BpfProgFilePath, dataSizeIn)
+
+	// ctx_in point to a valid struct __sk_buff
+	// make sure the fields don't use are zeroed
+	ctxIn := NewValidSkBuffForTestRun(r)
+	ctxSizeIn := len(ctxIn)
+	dataOut := make([]byte, dataSizeIn)
+
+	return BpfProgTestRunStruct{
+		// ProgFD: The file descriptor of the BPF program to test.
+		ProgFD: bpfProg.BpfProgContext.ProgFD,
+
+		DataSizeIn:  uint32(dataSizeIn),
+		DataSizeOut: uint32(len(dataOut)),
+		DataIn:      dataIn,
+		DataOut:     dataOut,
+
+		Repeat:   uint32(r.Intn(REPEAT_TIMES)),
+		Duration: r.Uint32(),
+
+		CtxSizeIn:  uint32(ctxSizeIn),       // Size of the input context data.
+		CtxSizeOut: uint32(ctxSizeIn),       // Size of the output context data.
+		CtxIn:      ctxIn,                   // struct __sk_buff, input context data
+		CtxOut:     make([]byte, ctxSizeIn), // Allocate space for the output context data.
+
+		// Flags, Cpu, BatchSize: These MUST be zero for skb-based test runs,
+		// as checked by bpf_prog_test_run_skb in the kernel.
+		Flags:     0,
+		Cpu:       0,
+		BatchSize: 0,
+	}
+}
+
+// XdpMd mirrors the kernel's `struct xdp_md`, which is the context
+// passed to XDP BPF programs.
+type XdpMd struct {
+	Data           uint32
+	DataEnd        uint32
+	DataMeta       uint32
+	IngressIfindex uint32
+	RxQueueIndex   uint32
+	EgressIfindex  uint32
+}
+
+// NewValidXdpMdForTestRun creates a byte representation of an XdpMd struct,
+// constructed to pass the checks in the kernel's bpf_prog_test_run_xdp function.
+// The `dataSize` parameter is crucial as `xdp_md.data_end` must match the
+// size of the packet data buffer used in the test.
+func NewValidXdpMdForTestRun(r *randGen, dataSize uint64) []byte {
+	// 1. Create a pointer to an XdpMd struct.
+	xdp := &XdpMd{
+		// 2. Set fields according to kernel validation rules.
+		// data and data_end define the packet boundaries. For a simple test,
+		// we set data to 0 (start of packet) and data_end to the packet's size.
+		Data:    uint32(r.Intn(int(dataSize))),
+		DataEnd: uint32(dataSize),
+
+		// data_meta must be zero.
+		DataMeta: 0,
+
+		// These are metadata fields that can be randomized for more robust testing.
+		IngressIfindex: uint32(r.Intn(16) + 1),
+		RxQueueIndex:   uint32(r.Intn(8)),
+		EgressIfindex:  0,
+	}
+
+	// 3. Get the total size of the struct in memory.
+	size := unsafe.Sizeof(*xdp)
+
+	// 4. Create a new, independent byte slice of the exact same size.
+	data := make([]byte, size)
+
+	// 5. Create a temporary unsafe view of the struct's memory.
+	xdpBytesView := (*[1 << 30]byte)(unsafe.Pointer(xdp))[:size:size]
+
+	// 6. Copy the content from the struct's memory view into the new slice.
+	copy(data, xdpBytesView)
+
+	// 7. Return the new, safe, and independent data slice.
+	return data
+}
+
+// PatchBpfProgTestRunXDP constructs valid parameters for the bpf_prog_test_run
+// command targeting a BPF program that expects an `xdp_md` context.
+func PatchBpfProgTestRunXDP(r *randGen, bpfProg *BpfProg) BpfProgTestRunStruct {
+	var flags uint32
+	var batchSize uint32
+	var ctxOut []byte
+	var ctxSizeOut uint32
+	var dataOut []byte
+
+	dataSizeIn := ETH_HLEN + r.Intn(MAX_Data_SIZE_IN*2)
+
+	// Create the input context first.
+	ctxIn := NewValidXdpMdForTestRun(r, uint64(dataSizeIn))
+
+	// Create random input data.
+	dataIn := make([]byte, dataSizeIn)
+	for i := range dataIn {
+		dataIn[i] = byte(r.Intn(256))
+	}
+
+	// Decide if we should attempt a "live frames" test run (do_live=true).
+	// This is only valid if the input data size is not too large and if
+	// output buffers (`ctx_out`, `data_out`) are NULL.
+	isLiveModePossible := dataSizeIn <= MAX_Data_SIZE_IN
+	useLiveMode := isLiveModePossible && (r.Intn(2) == 0)
+
+	if useLiveMode {
+		// Live frames test run (do_live = true).
+		flags = BPF_F_TEST_XDP_LIVE_FRAMES
+		batchSize = uint32(r.Intn(TEST_XDP_MAX_BATCH)) // Random value 0-255
+		// In this mode, `ctx_out` and `data_out` must be NULL.
+		ctxOut = nil
+		ctxSizeOut = 0
+		dataOut = nil
+	} else {
+		// Standard test run (do_live = false).
+		flags = 0
+		// In this mode, batch_size MUST be 0.
+		batchSize = 0
+		// We can provide an output context buffer.
+		ctxOut = make([]byte, len(ctxIn))
+		ctxSizeOut = uint32(len(ctxOut))
+		// We can provide an output data buffer.
+		dataOut = make([]byte, dataSizeIn)
+	}
+
+	return BpfProgTestRunStruct{
+		// ProgFD: The file descriptor of the BPF program to test.
+		ProgFD: bpfProg.BpfProgContext.ProgFD,
+
+		DataSizeIn:  uint32(len(dataIn)),
+		DataSizeOut: uint32(len(dataOut)),
+		DataIn:      dataIn,
+		DataOut:     dataOut,
+
+		Repeat:   uint32(r.Intn(REPEAT_TIMES)),
+		Duration: r.Uint32(),
+
+		// CtxIn: The `xdp_md` context. Its `data_end` field is now consistent
+		// with the `dataSizeIn` parameter.
+		CtxSizeIn:  uint32(len(ctxIn)),
+		CtxSizeOut: ctxSizeOut,
+		CtxIn:      ctxIn,
+		CtxOut:     ctxOut,
+
+		Flags:     flags,
+		Cpu:       uint32(r.Intn(MAX_CPUS)), // TODO: We can pick a random CPU.
+		BatchSize: batchSize,
+	}
+}
+
+// PatchBpfProgTestRunRawTp constructs valid parameters for the bpf_prog_test_run
+// command targeting a BPF program attached to a raw tracepoint.
+func PatchBpfProgTestRunRawTp(r *randGen, bpfProg *BpfProg) BpfProgTestRunStruct {
+	var flags uint32
+	var cpu uint32
+
+	// The kernel has a strict check: if BPF_F_TEST_RUN_ON_CPU is not set, cpu must be 0.
+	if r.Intn(2) == 0 {
+		// Standard run on the current CPU.
+		flags = 0
+		cpu = 0
+	} else {
+		// Run on a specific CPU.
+		flags = BPF_F_TEST_RUN_ON_CPU
+		// TODO: We can pick a random CPU.
+		cpu = uint32(r.Intn(MAX_CPUS))
+	}
+
+	// For raw_tp, ctx_size_in cannot exceed MAX_BPF_FUNC_ARGS * sizeof(u64).
+	// We generate a valid size by choosing a random number of u64 arguments.
+	numArgs := r.Intn(MAX_BPF_FUNC_ARGS + 1) // 0 to MAX_BPF_FUNC_ARGS
+
+	// TODO, ctx_in must be a valid context for the specific raw tracepoint.
+	ctxSizeIn := uint32(numArgs * 8)
+	ctxIn := make([]byte, ctxSizeIn)
+	for i := range ctxIn {
+		ctxIn[i] = byte(r.Intn(256))
+	}
+
+	// From the kernel source `bpf_prog_test_run_raw_tp`:
+	// It "doesn't support data_in/out, ctx_out, duration, or repeat".
+	// All corresponding fields must be zero/nil.
+	return BpfProgTestRunStruct{
+		ProgFD: bpfProg.BpfProgContext.ProgFD,
+
+		// Unsupported fields, must be zero/nil.
+		DataSizeIn:  0,
+		DataSizeOut: 0,
+		DataIn:      nil,
+		DataOut:     nil,
+
+		Repeat:   0,
+		Duration: 0,
+
+		CtxSizeIn:  ctxSizeIn,
+		CtxSizeOut: 0,
+		CtxIn:      ctxIn,
+		CtxOut:     nil,
+
+		// Supported fields.
+		Flags:     flags,
+		BatchSize: 0,
+		Cpu:       cpu,
+	}
+}
