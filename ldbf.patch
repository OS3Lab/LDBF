@@ -0,0 +1,278 @@
+package prog
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// bpfAttrInfo holds the metadata needed to find the BPF instructions.
+type bpfAttrInfo struct {
+	baseAddr  uint64 // The base address of the bpf_attr struct
+	insnsAddr uint64 // The address where the instructions are stored
+	insnsCnt  uint32 // The number of instructions
+}
+
+// ... (memWrite, storeBitmask, memSet structs remain the same) ...
+type memWrite struct {
+	addr  uint64
+	value uint64
+	size  int
+}
+type storeBitmask struct {
+	addr  uint64
+	value uint64
+	off   uint64
+	len   uint64
+}
+type memSet struct {
+	addr  uint64
+	value uint64
+	size  uint64
+}
+
+var (
+	// MODIFIED: Made the "_t" optional in the type to match both "uint32" and "uint32_t"
+	directWriteRegex = regexp.MustCompile(`\*\((uint(8|16|32|64))(_t)?\*?\)(0x[0-9a-f]+)\s*=\s*(-?0x[0-9a-f]+|-?[0-9]+)`)
+
+	// MODIFIED: Made the "_t" optional in storeBitmaskRegex as well for consistency
+	storeBitmaskRegex = regexp.MustCompile(`STORE_BY_BITMASK\(\s*uint8(_t)?\s*,\s*,\s*(0x[0-9a-f]+)\s*,\s*(0x[0-9a-f]+|[0-9]+)\s*,\s*([0-9]+)\s*,\s*([0-9]+)\s*\)`)
+
+	memsetRegex = regexp.MustCompile(`memset\(\s*\(void\*\)(0x[0-9a-f]+)\s*,\s*(0x[0-9a-f]+|[0-9]+)\s*,\s*([0-9]+)\s*\)`)
+)
+
+// ... (parseUint, parseInt functions remain the same) ...
+func parseUint(s string) (uint64, error) {
+	return strconv.ParseUint(strings.TrimPrefix(s, "0x"), 16, 64)
+}
+func parseInt(s string) (int64, error) {
+	if strings.HasPrefix(s, "-") {
+		val, err := strconv.ParseUint(strings.TrimPrefix(s, "-0x"), 16, 64)
+		if err != nil {
+			return 0, err
+		}
+		return -int64(val), nil
+	}
+	return strconv.ParseInt(strings.TrimPrefix(s, "0x"), 16, 64)
+}
+
+func extractBPFInstructions(cCode string) ([]byte, error) {
+	memory := make(map[uint64]byte)
+	var attrInfo bpfAttrInfo
+
+	lines := strings.Split(cCode, "\n")
+
+	// --- Step 1: Dynamically find the base address from the first valid line ---
+	var firstLine string
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		if trimmed != "" {
+			firstLine = trimmed
+			break
+		}
+	}
+	if firstLine == "" {
+		return nil, fmt.Errorf("input code is empty")
+	}
+
+	// Clean up and parse the first line to get the base address
+	cleanFirstLine := strings.TrimSuffix(strings.TrimPrefix(firstLine, "NONFAILING("), ")")
+	// MODIFIED: Also trim the semicolon to ensure a clean match
+	cleanFirstLine = strings.TrimSpace(strings.TrimSuffix(cleanFirstLine, ";"))
+
+	if matches := directWriteRegex.FindStringSubmatch(cleanFirstLine); len(matches) > 0 {
+		// Note: Regex group indices shift because of the new optional group (_t)?
+		// The address is now in group 4.
+		baseAddr, err := parseUint(matches[4])
+		if err != nil {
+			return nil, fmt.Errorf("could not parse base address from first line: %v", err)
+		}
+		attrInfo.baseAddr = baseAddr
+	} else {
+		return nil, fmt.Errorf("first line '%s' does not match expected format for base address extraction", cleanFirstLine)
+	}
+
+	// --- Pass 2: Find insns address and count using the dynamic base address ---
+	for _, line := range lines {
+		cleanLine := strings.TrimSpace(line)
+		if strings.HasPrefix(cleanLine, "NONFAILING(") {
+			cleanLine = strings.TrimSuffix(strings.TrimPrefix(cleanLine, "NONFAILING("), ")")
+		}
+
+		if matches := directWriteRegex.FindStringSubmatch(cleanLine); len(matches) > 0 {
+			// Address is in group 4, value is in group 5
+			addr, _ := parseUint(matches[4])
+			val, _ := parseInt(matches[5])
+
+			if addr == attrInfo.baseAddr+4 {
+				attrInfo.insnsCnt = uint32(val)
+			}
+			if addr == attrInfo.baseAddr+8 {
+				attrInfo.insnsAddr = uint64(val)
+			}
+		}
+	}
+
+	if attrInfo.insnsAddr == 0 || attrInfo.insnsCnt == 0 {
+		return nil, fmt.Errorf("could not find BPF insns address or count using base address 0x%x", attrInfo.baseAddr)
+	}
+
+	// --- Pass 3: Populate the memory map ---
+	for _, line := range lines {
+		cleanLine := strings.TrimSpace(line)
+		if strings.HasPrefix(cleanLine, "NONFAILING(") {
+			cleanLine = strings.TrimSuffix(strings.TrimPrefix(cleanLine, "NONFAILING("), ")")
+		}
+		cleanLine = strings.Trim(cleanLine, ";")
+
+		if matches := directWriteRegex.FindStringSubmatch(cleanLine); len(matches) > 0 {
+			// Type is in group 1, address in 4, value in 5
+			typeName := matches[1]
+			addr, _ := parseUint(matches[4])
+			val, _ := parseInt(matches[5])
+			val64 := uint64(val)
+			byteSize := 0
+			switch typeName {
+			case "uint8":
+				byteSize = 1
+			case "uint16":
+				byteSize = 2
+			case "uint32":
+				byteSize = 4
+			case "uint64":
+				byteSize = 8
+			}
+			buf := make([]byte, byteSize)
+			switch byteSize {
+			case 1:
+				buf[0] = byte(val64)
+			case 2:
+				binary.LittleEndian.PutUint16(buf, uint16(val64))
+			case 4:
+				binary.LittleEndian.PutUint32(buf, uint32(val64))
+			case 8:
+				binary.LittleEndian.PutUint64(buf, val64)
+			}
+			for i := 0; i < byteSize; i++ {
+				memory[addr+uint64(i)] = buf[i]
+			}
+		} else if matches := storeBitmaskRegex.FindStringSubmatch(cleanLine); len(matches) > 0 {
+			// Group indices shift here as well
+			addr, _ := parseUint(matches[2])
+			val, _ := parseUint(matches[3])
+			off, _ := parseUint(matches[4])
+			blen, _ := parseUint(matches[5])
+			mask := ((uint64(1) << blen) - 1) << off
+			oldVal := uint64(memory[addr])
+			newVal := (oldVal & ^mask) | ((val << off) & mask)
+			memory[addr] = byte(newVal)
+		} else if matches := memsetRegex.FindStringSubmatch(cleanLine); len(matches) > 0 {
+			addr, _ := parseUint(matches[1])
+			val, _ := parseUint(matches[2])
+			size, _ := parseUint(matches[3])
+			for i := uint64(0); i < size; i++ {
+				memory[addr+i] = byte(val)
+			}
+		}
+	}
+
+	// --- Step 4: Extract the bytecode ---
+	totalBytes := uint64(attrInfo.insnsCnt * 8)
+	bytecode := make([]byte, totalBytes)
+	for i := uint64(0); i < totalBytes; i++ {
+		addr := attrInfo.insnsAddr + i
+		bytecode[i] = memory[addr]
+	}
+
+	return bytecode, nil
+}
+
+// generateOutputPath generates an output file path based on an input file path.
+// 1. Creates a "corpus" subdirectory in the same directory as the input file.
+// 2. Appends a timestamp to the original filename to create the new filename.
+func generateOutputPath(inputFile string, isBpfRaw bool) (string, error) {
+	// Step 1: Parse the input path to get the directory, full filename, base name, and extension.
+	var base string
+	var ext string
+	var err error
+	var baseName string
+
+	if isBpfRaw {
+		baseName = "bpf"
+		ext = ".txt"
+	} else {
+		base = filepath.Base(inputFile)
+		ext = filepath.Ext(base)
+		// strings.TrimSuffix removes the extension from the filename to get the base name.
+		baseName = strings.TrimSuffix(base, ext)
+	}
+
+	// Step 2: Construct the output directory path.
+	// filepath.Join safely handles path separators (/ or \).
+	outputDir, err := JoinLdbfLoraDir("corpus")
+	if err != nil {
+		return "", fmt.Errorf("failed to get output directory: %w", err)
+	}
+
+	// Step 3: Generate a timestamp string with millisecond precision.
+	timestamp := time.Now().Format("060102150405.000")
+
+	// Step 4: Construct the new filename with the timestamp.
+	// Sprintf is used to format the string, joining the different parts.
+	var outputFilename string
+	outputFilename = fmt.Sprintf("%s-%s%s", baseName, timestamp, ext)
+
+	// Step 5: Join the output directory and output filename to create the final full path.
+	outputFile := filepath.Join(outputDir, outputFilename)
+
+	return outputFile, nil
+}
+
+func (Ldbf *LLMDrivenBPFuzzer) ExtBpfProgLoadCallInsn(call int, p *Prog, bpfProgArgC string, isBpfRaw bool) {
+	bytecode, err := extractBPFInstructions(bpfProgArgC)
+	if err != nil {
+		// fmt.Printf("ExtBpfProgLoadCallInsn: Error extracting BPF instructions: %v\n", err)
+		return
+	}
+
+	// 1. Create a strings.Builder for efficient string construction.
+	var bytes_buffer strings.Builder
+
+	// 2. Loop through the bytecode, writing the formatted content to the strings.Builder instead of printing directly.
+	for i := 0; i < len(bytecode); i++ {
+		// Use fmt.Fprintf to write the formatted string to the builder.
+		// _, err := fmt.Fprintf(&bytes_buffer, "0x%02x", bytecode[i])
+		if err != nil {
+			// fmt.Printf("ExtBpfProgLoadCallInsn: Error writing to string builder: %v\n", err)
+		}
+
+		// If it's not the last byte, add a comma and a space.
+		if i+1 < len(bytecode) {
+			bytes_buffer.WriteString(", ")
+		}
+	}
+	bpfProg := Ldbf.GetLdbfBpfProg()
+	if bpfProg == nil {
+		// fmt.Printf("ExtBpfProgLoadCallInsn: Error: LDBF BPF program is nil, cannot extract BPF instructions.\n")
+		return
+	}
+	outputFile, err := generateOutputPath(bpfProg.BpfProgFilePath, isBpfRaw)
+	if err != nil {
+		// fmt.Printf("ExtBpfProgLoadCallInsn: Error generates the output file path based on: %s, error:%v\n", bpfProg.BpfProgFilePath, err)
+		return
+	}
+	// 3. Write the final constructed string to the file.
+	// os.WriteFile requires a []byte, so we convert the builder's string.
+	// fmt.Printf("ExtBpfProgLoadCallInsn: Writing to file: %s: %s\n", outputFile, bytes_buffer.String())
+	if err := os.WriteFile(outputFile, []byte(bytes_buffer.String()), 0644); err != nil {
+		// fmt.Printf("ExtBpfProgLoadCallInsn: Error writing formatted bytecode to file: %v\n", err)
+		return
+	}
+
+	bpfProg.BpfRawInsnExtracted = true
+}
