+// The return value of getBpfMapType is []*BpfMapTypeStruct, whether to load BPF Map
+func (Ldbf *LLMDrivenBPFuzzer) getBpfMapTypes(r *randGen, s *state, bpfProg *BpfProg) ([]*BpfMapTypeStruct, []int, bool) {
+	LDBFDir := os.Getenv("LDBF_DIR") + "/"
+	if LDBFDir == "/" {
+		panic("LDBF_DIR environment variable is not set")
+	}
+
+	helperMapTypeFile := LDBFDir + "dependency/func_map.json"
+	dependenciesJSON, err := ReadFileContent(helperMapTypeFile)
+	if err != nil {
+		return nil, nil, false
+	}
+
+	var supportedMapTypes map[string][]string
+
+	supportedMapTypes, bpfLoadMapInsnIndex, err := extractSupportedMapTypes(bpfProg, dependenciesJSON)
+	if err != nil {
+		return nil, nil, false
+	}
+
+	if len(bpfMapTypeArray) == 0 {
+		panic("bpfMapTypeArray is empty, cannot select a map type")
+	}
+
+	// When no BPF map instance is found, an empty slice is returned.
+	if len(supportedMapTypes) == 0 {
+		// No BPF map instances found (via BPF_LD_MAP_FD), selecting randomly from all types.
+		// fmt.Println("No BPF map instances found (via BPF_LD_MAP_FD), selecting randomly from all types.")
+		randomIndex := int(r.rand(len(bpfMapTypeArray)))
+		tempMapType := &bpfMapTypeArray[randomIndex]
+
+		mapTypeCopy := new(BpfMapTypeStruct)
+		*mapTypeCopy = *tempMapType
+
+		// Add a copy of the map type created for the current instance to the final result slice
+		resultMaps := make([]*BpfMapTypeStruct, 0, 1)
+		resultMaps = append(resultMaps, mapTypeCopy)
+
+		// fmt.Printf("Selected map type: %s\n", mapTypeCopy.Name)
+		// fmt.Printf("Total maps selected: %d\n\n", len(resultMaps))
+		return resultMaps, bpfLoadMapInsnIndex, false
+	}
+
+	// Select a map type for each map instance found in the BPF program
+
+	// Create the final result slice, pre-allocating capacity for efficiency
+	resultMaps := make([]*BpfMapTypeStruct, 0, len(supportedMapTypes))
+
+	// Iterate over each map instance (mapInstanceID) and the list of map type names it supports (mapTypeNames)
+	for mapInstanceID, mapTypeNames := range supportedMapTypes {
+		// fmt.Printf("Supported map types for instance %s: %v\n", mapInstanceID, mapTypeNames)
+
+		// Select independently for the current map instance
+		var tempMapType *BpfMapTypeStruct
+
+		// Creates a temporary set of the map type name for the current instance.
+		instanceAllowedNames := make(map[string]struct{})
+		for _, name := range mapTypeNames {
+			instanceAllowedNames[name] = struct{}{}
+		}
+
+		// Iterate over the global bpfMapTypeArray to find matching candidates for the current instance
+		var instanceCandidates []*BpfMapTypeStruct
+		for i := range bpfMapTypeArray {
+			if _, ok := instanceAllowedNames[bpfMapTypeArray[i].Name]; ok {
+				instanceCandidates = append(instanceCandidates, &bpfMapTypeArray[i])
+			}
+		}
+
+		// Randomly select one from the candidates of the current instance
+		if len(instanceCandidates) > 0 {
+			// fmt.Printf("Found %d candidate(s) for instance '%s', selecting one randomly.\n", len(instanceCandidates), mapInstanceID)
+			randomIndex := int(r.rand(len(instanceCandidates)))
+			tempMapType = instanceCandidates[randomIndex]
+		} else {
+			// If none of the types supported by the current instance are found in the main array
+			// fmt.Printf("Warning: No matching types in master list for instance '%s'. Falling back to random selection.\n", mapInstanceID)
+			randomIndex := int(r.rand(len(bpfMapTypeArray)))
+			tempMapType = &bpfMapTypeArray[randomIndex]
+		}
+
+		// Dynamic allocation and copying ensure that each returned element is an independent copy
+		if tempMapType == nil {
+			// In theory it shouldn't happen because there is fallback logic, but as a safety check
+			panic(fmt.Sprintf("Failed to select a map type for instance '%s'", mapInstanceID))
+		}
+		mapTypeCopy := new(BpfMapTypeStruct)
+		*mapTypeCopy = *tempMapType
+		// fmt.Printf("Selected for instance '%s': %s\n", mapInstanceID, mapTypeCopy.Name)
+
+		// Add a copy of the map type created for the current instance to the final result slice
+		resultMaps = append(resultMaps, mapTypeCopy)
+	}
+	// fmt.Printf("Total maps selected: %d\n\n", len(resultMaps))
+	return resultMaps, bpfLoadMapInsnIndex, true
+}
+
+// calculateIntersection calculates the intersection.
+// Return value:
+// 1. []string: The calculated intersection result.
+// 2. bool: A flag. If true, it means that all map types should be supported (because all associated helpers are undefined).
+func calculateIntersection(helpers []string, dependencies map[string][]string) ([]string, bool) {
+	// Filter out helpers that are explicitly defined in dependencies
+	var definedHelpers []string
+	for _, h := range helpers {
+		if _, found := dependencies[strings.ToUpper(h)]; found {
+			definedHelpers = append(definedHelpers, h)
+		}
+	}
+
+	// If no helper is defined, all map types should be supported.
+	if len(definedHelpers) == 0 {
+		// Returns a true flag to inform the caller to use the "all types" list
+		return nil, true
+	}
+
+	// At least one helper is defined, and the intersection is calculated based on these defined helpers
+	// Initialize the intersection using the first defined helper
+	firstHelperName := strings.ToUpper(definedHelpers[0])
+	initialMapTypes := dependencies[firstHelperName]
+
+	intersectionSet := make(map[string]struct{})
+	for _, mt := range initialMapTypes {
+		intersectionSet[mt] = struct{}{}
+	}
+
+	// Traverse the remaining defined helpers and keep reducing the intersection
+	for i := 1; i < len(definedHelpers); i++ {
+		nextHelperName := strings.ToUpper(definedHelpers[i])
+		nextMapTypes := dependencies[nextHelperName]
+
+		currentHelperSet := make(map[string]struct{})
+		for _, mt := range nextMapTypes {
+			currentHelperSet[mt] = struct{}{}
+		}
+
+		nextIntersectionSet := make(map[string]struct{})
+		for mt := range intersectionSet {
+			if _, ok := currentHelperSet[mt]; ok {
+				nextIntersectionSet[mt] = struct{}{}
+			}
+		}
+		intersectionSet = nextIntersectionSet
+		if len(intersectionSet) == 0 {
+			break
+		}
+	}
+
+	// Convert the final intersection set back into a string slice
+	result := make([]string, 0, len(intersectionSet))
+	for mt := range intersectionSet {
+		result = append(result, mt)
+	}
+
+	// Returns the calculated intersection and the false flag
+	return result, false
+}
+
+func extractSupportedMapTypes(bpfProg *BpfProg, jsonDependencies string) (map[string][]string, []int, error) {
+	var mapLoadRegex = regexp.MustCompile(`BPF_LD_MAP_FD\((\w+),\s*(0x[0-9a-fA-F]+|\d+)\)`)
+	var helperRegex = regexp.MustCompile(`(?:BPF_RAW_INSN|BPF_EMIT_CALL)\((?:.*,\s*)?(\w+)\)`)
+	var otherRegWriteRegex = regexp.MustCompile(`\b(BPF_MOV64_REG|BPF_MOV64_IMM|BPF_ALU64_REG|BPF_ALU64_IMM|BPF_LDX_MEM)\((BPF_REG_[1-2]),`)
+
+	var mapValueLoadRegex = regexp.MustCompile(`BPF_LD_MAP_VALUE`)
+	var ldImm64Regex = regexp.MustCompile(`BPF_LD_IMM64(?:_RAW(?:_FULL)?)?`)
+
+	var dependencies map[string][]string
+	if err := json.Unmarshal([]byte(jsonDependencies), &dependencies); err != nil {
+		return nil, nil, fmt.Errorf("fail to parse JSON file: %w", err)
+	}
+
+	// Convert the contents of dependencies to all uppercase
+	upperDependencies := make(map[string][]string)
+	for key, valueSlice := range dependencies {
+		upperKey := strings.ToUpper(key)
+		upperValueSlice := make([]string, len(valueSlice))
+		for i, value := range valueSlice {
+			upperValueSlice[i] = strings.ToUpper(value)
+		}
+		upperDependencies[upperKey] = upperValueSlice
+	}
+	dependencies = upperDependencies
+
+	allMapTypeSet := make(map[string]struct{})
+	for _, mapTypes := range dependencies {
+		for _, mt := range mapTypes {
+			allMapTypeSet[mt] = struct{}{}
+		}
+	}
+	allMapTypeNames := make([]string, 0, len(allMapTypeSet))
+	for mt := range allMapTypeSet {
+		allMapTypeNames = append(allMapTypeNames, mt)
+	}
+
+	lines := strings.Split(bpfProg.BpfProgContent, "\n")
+	mapHelpers := make(map[string][]string)
+	var bpfLoadMapInsnIndex []int
+	var loadMapInsnIndex int = 0
+
+	var isReg1FromMapFD bool = false
+	var isReg2FromMapFD bool = false
+	// lastReg1MapLoadIndex records the index of the last instruction that loaded an FD into BPF_REG_1 or BPF_REG_2.
+	var lastReg1MapLoadIndex int = -1
+	var lastReg2MapLoadIndex int = -1
+	// mapIDToInsnIndex associates a map instance ID with the index of its BPF_LD_MAP_FD instruction.
+	mapIDToInsnIndex := make(map[string]int)
+	var mapIdx int = 0
+
+	for _, line := range lines {
+		// Detecting BPF_LD_MAP_FD instructions
+		if match := mapLoadRegex.FindStringSubmatch(line); len(match) > 2 {
+			destReg := match[1]
+			if destReg == "BPF_REG_1" {
+				isReg1FromMapFD = true
+				lastReg1MapLoadIndex = loadMapInsnIndex
+			} else if destReg == "BPF_REG_2" {
+				isReg2FromMapFD = true
+				lastReg2MapLoadIndex = loadMapInsnIndex
+			}
+			// Check for other instructions that overwrite BPF_REG_1.
+		} else if match := otherRegWriteRegex.FindStringSubmatch(line); len(match) > 2 {
+			destReg := match[2]
+			if destReg == "BPF_REG_1" {
+				isReg1FromMapFD = false
+			} else if destReg == "BPF_REG_2" {
+				isReg2FromMapFD = false
+			}
+			// Check for helper function call.
+		} else if match := helperRegex.FindStringSubmatch(line); len(match) > 1 {
+			// If the state of BPF_REG_1 is from a map FD, this helper is map-dependent.
+			helperName := match[1]
+			// If the helper use BPF_REG_2 as map FD source, also check its state.
+			if contains(bpfHelperUseReg2ForMap, helperName) && isReg2FromMapFD {
+				mapID := ""
+				for id, index := range mapIDToInsnIndex {
+					if index == lastReg2MapLoadIndex {
+						mapID = id
+						break
+					}
+				}
+
+				// If not yet recorded, create it now.
+				if mapID == "" {
+					// mapID = fmt.Sprintf("map_idx_%d", mapIdx)
+					mapIDToInsnIndex[mapID] = lastReg2MapLoadIndex
+					mapHelpers[mapID] = []string{}
+					bpfLoadMapInsnIndex = append(bpfLoadMapInsnIndex, lastReg2MapLoadIndex)
+					mapIdx++
+				}
+				mapHelpers[mapID] = append(mapHelpers[mapID], helperName)
+				//fmt.Printf("Associated reg2 map-dependent helper '%s' with %s (from insn %d)\n", helperName, mapID, lastReg2MapLoadIndex)
+			} else if isReg1FromMapFD {
+				// Check if this map instance has already been recorded.
+				mapID := ""
+				for id, index := range mapIDToInsnIndex {
+					if index == lastReg1MapLoadIndex {
+						mapID = id
+						break
+					}
+				}
+
+				// If not yet recorded, create it now.
+				if mapID == "" {
+					// mapID = fmt.Sprintf("map_idx_%d", mapIdx)
+					mapIDToInsnIndex[mapID] = lastReg1MapLoadIndex
+					mapHelpers[mapID] = []string{}
+					bpfLoadMapInsnIndex = append(bpfLoadMapInsnIndex, lastReg1MapLoadIndex)
+					mapIdx++
+				}
+
+				mapHelpers[mapID] = append(mapHelpers[mapID], helperName)
+				//fmt.Printf("Associated map-dependent helper '%s' with %s (from insn %d)\n", helperName, mapID, lastReg1MapLoadIndex)
+			}
+			// Any helper call clobbers the state of R, so always reset it.
+			isReg1FromMapFD = false
+			isReg2FromMapFD = false
+		}
+
+		// When a BPF_LD_MAP_VALUE instruction is found, it is considered to be a bpf map load instruction.
+		if mapValueLoadRegex.MatchString(line) {
+			// fmt.Printf("Found BPF_LD_MAP_VALUE at line %d, from the BPF program: %s\n\n", loadMapInsnIndex, bpfProg.BpfProgFilePath)
+			panic("Ldbf: BPF_LD_MAP_VALUE instruction found, which is not supported in this context. TODO.")
+		}
+		if ldImm64Regex.MatchString(line) {
+			loadMapInsnIndex++ // Additional 1
+		}
+		loadMapInsnIndex++
+	}
+
+	// fmt.Printf("Extracted %d map instances from the BPF program: %s\n", len(mapHelpers), bpfProg.BpfProgFilePath)
+	// fmt.Printf("Found %d BPF_LD_MAP_FD instructions in the program content:\n%s\n", len(bpfLoadMapInsnIndex), bpfProg.BpfProgContent)
+
+	// Calculate the supported map types for each map group
+	mapsHelpersMap := make(map[string][]string)
+	for mapID, helpers := range mapHelpers {
+		// Call the modified intersection function
+		intersectedMapTypes, useAllTypes := calculateIntersection(helpers, dependencies)
+
+		if useAllTypes {
+			// If the flag is true, use the pre-generated list of all map types
+			mapsHelpersMap[mapID] = allMapTypeNames
+		} else {
+			// Otherwise, use the calculated intersection result
+			mapsHelpersMap[mapID] = intersectedMapTypes
+		}
+		// fmt.Printf("For %s, supported map types: %v, based on helpers: %v, from program:%s\n\n", mapID, mapsHelpersMap[mapID], helpers, bpfProg.BpfProgFilePath)
+	}
+	// map types list |
+	return mapsHelpersMap, bpfLoadMapInsnIndex, nil
+}
+
+func (Ldbf *LLMDrivenBPFuzzer) genLdbfMapCreateCall(r *randGen, s *state, bpfProg *BpfProg) []*Call {
+	// find the map type the bpfinsn supports
+	supportedMapTypes, bpfLoadMapInsnIndex, needLoadMapFd := Ldbf.getBpfMapTypes(r, s, bpfProg)
+
+	if supportedMapTypes == nil {
+		// fmt.Printf("\nSelected BpfProgFilePath: %s\n", bpfProg.BpfProgFilePath)
+		panic("Ldbf: genLdbfMapCreateCall no supported BPF map types found")
+	}
+
+	var bpfMapCalls []*Call
+	var bpfMapRes []*ResultArg
+
+	for _, mapType := range supportedMapTypes {
+		calls := genSingleMapCreateCall(r, s, bpfProg, mapType)
+		if len(calls) == 0 {
+			continue
+		}
+		c := calls[len(calls)-1]
+
+		val := uint64(mapType.MapType)
+		bpfProg.BpfProgContext.MapTypes = append(bpfProg.BpfProgContext.MapTypes, val)
+
+		if needLoadMapFd {
+			bpfMapRes = append(bpfMapRes, c.Ret)
+		}
+
+		var currentBpfMapCall []*Call
+		//currentBpfMapCall = append(currentBpfMapCall, calls...)     // First add resource related calls
+		//currentBpfMapCall = append(currentBpfMapCall, moreCalls...) // Then add the call to the conditional field
+		currentBpfMapCall = append(currentBpfMapCall, calls...) // Finally add the MAP_CREATE call itself
+
+		bpfMapCalls = append(bpfMapCalls, currentBpfMapCall...)
+	}
+
+	if bpfProg.BpfMapResMap == nil {
+		bpfProg.BpfMapResMap = make(map[int]*ResultArg, len(bpfLoadMapInsnIndex))
+	}
+
+	if needLoadMapFd {
+		if len(bpfLoadMapInsnIndex) != len(bpfMapRes) {
+			// fmt.Printf("Assign to map failed: array lengths are not equal (%d != %d)", len(bpfLoadMapInsnIndex), len(bpfMapRes))
+			// panic("Ldbf: genLdbfMapCreateCall: bpfLoadMapInsnIndex and bpfMapRes length mismatch")
+		} else {
+			for mapIndex, loadMapIndex := range bpfLoadMapInsnIndex {
+				bpfProg.BpfMapResMap[loadMapIndex] = bpfMapRes[mapIndex]
+			}
+		}
+	}
+
+	return bpfMapCalls
+}
+
+// Separate the creation of the bpf$LDBF_MAP_CREATE into genSingleMapCreateCall
+func genSingleMapCreateCall(r *randGen, s *state, bpfProg *BpfProg, mapType *BpfMapTypeStruct) []*Call {
+	var calls []*Call
+	meta := r.target.SyscallMap["bpf$LDBF_MAP_CREATE"]
+	//meta := r.target.SyscallMap["bpf$MAP_CREATE"]
+	c := MakeCall(meta, nil)
+
+	argCalls, _ := r.generateArgs(s, meta.Args, DirIn)
+	c.Args = argCalls
+
+	// bpf_map_create_arg ptr
+	cArgField, ok := c.Args[1].Type().(*PtrType)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: c.Args[1] is not a pointer type, got %T\n", c.Args[1].Type())
+		return calls
+	}
+
+	// bpf_map_create_arg union
+	bpfMapCreateArgType, ok := cArgField.Elem.(*UnionType)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: cArgField.Elem is not a UnionType, got %T\n", cArgField.Elem)
+		return calls
+	}
+	bpfMapCreateArgTypeDir := cArgField.ElemDir
+
+	// bpf_map_create_arg_base index
+	bpfMapCreateArgBaseIdx := 0
+	bpfMapCreateArgBaseType := bpfMapCreateArgType.Fields[bpfMapCreateArgBaseIdx].Type
+	bpfMapCreateArgType.Fields[bpfMapCreateArgBaseIdx].Dir(cArgField.ElemDir)
+
+	// bpf_map_create_arg_base, bpf_map_create_arg_t struct
+	bpfMapCreateArgT, ok := bpfMapCreateArgBaseType.(*StructType)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: bpfMapCreateArgBaseType is not a StructType, got %T\n", bpfMapCreateArgBaseType)
+		return calls
+	}
+	bpfMapCreateArgTDir := bpfMapCreateArgType.Fields[bpfMapCreateArgBaseIdx].Dir(bpfMapCreateArgTypeDir)
+
+	// bpf_map_create_arg ptr arg
+	ptrArg, ok := c.Args[1].(*PointerArg)
+	if !ok || ptrArg.Res == nil {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: c.Args[1] is not a PointerArg, got %T\n", c.Args[1])
+		return calls
+	}
+
+	// bpf_map_create_arg union arg
+	unionArg, ok := ptrArg.Res.(*UnionArg)
+	if !ok || unionArg.Option == nil {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: c.Args[1].Res is not a UnionArg, got %T\n", ptrArg.Res)
+		return calls
+	}
+
+	// bpf_map_create_arg_t struct arg
+	originalStructArg, ok := unionArg.Option.(*GroupArg)
+	if !ok {
+		// fmt.Printf("Ldbf: genLdbfMapCreateCall: unionArg.Option is not a GroupArg, got %T\n", unionArg.Option)
+		return calls
+	}
+
+	for bpfMapCreateArgTIdx, bpfMapCreateArgTField := range bpfMapCreateArgT.Fields {
+		var newArg Arg
+
+		bpfMapCreateArgTFieldDir := bpfMapCreateArgTField.Dir(bpfMapCreateArgTDir)
+		switch bpfMapCreateArgTIdx {
+		case 0: // map_type, type
+			val := uint64(mapType.MapType)
+			newArg = MakeConstArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, val)
+
+		case 1: // key_size, ksize
+			if KeySize, ok := selectKeyFields(r, mapType.KeySize, KeyValSize((r.rand(20)+1)*4)); ok {
+				newArg = MakeConstArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, uint64(KeySize))
+			}
+
+		case 2: // value_size, vsize
+			if ValSize, ok := selectKeyFields(r, mapType.ValSize, KeyValSize((r.rand(20)+1)*4)); ok {
+				newArg = MakeConstArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, uint64(ValSize))
+			}
+
+		case 3: // max_entries, max
+			if MaxEntries, ok := selectKeyFields(r, mapType.MaxEntries, KeyValSize((r.rand(20)+1)*4)); ok {
+				newArg = MakeConstArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, uint64(MaxEntries))
+			}
+		case 4: // map_flags, flag
+			if MapFlags, ok := selectKeyFields(r, mapType.MapFlags, KVSize0); ok {
+				newArg = MakeConstArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTField.Dir(bpfMapCreateArgTDir), uint64(MapFlags))
+			}
+
+		case 6, 12, 13: // Initialize other ConstArg parameters to 0
+			newArg = MakeConstArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, 0)
+
+		case 9: // btf_fd
+			if mapType.NeedBtf {
+				newArg = MakeResultArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, bpfProg.BtfRes, 0)
+			} else {
+				newArg = MakeResultArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, nil, 0)
+			}
+
+		case 10, 11: //btf_key_type_id btf_value_type_id
+			if mapType.NeedBtf {
+				newArg = MakeConstArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, 1)
+			} else {
+				newArg = MakeConstArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, 0)
+			}
+
+		case 5: // inner_map_fd
+			if mapType.NeedInner {
+				InnerMap := genSingleMapCreateCall(r, s, bpfProg, &bpfMapTypeArray[r.rand(32)+1]) // Use BPF_MAP_TYPE_HASH as the inner map type
+				if InnerMap != nil && len(InnerMap) > 0 {
+					calls = append(calls, InnerMap...)
+					newArg = MakeResultArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, InnerMap[len(InnerMap)-1].Ret, 0)
+				} else {
+					newArg = MakeResultArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, nil, 0)
+				}
+			} else {
+				newArg = MakeResultArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, nil, 0)
+			}
+		case 8:
+			newArg = MakeResultArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, nil, 0)
+
+		case 7:
+			//newArg = MakeDataArg(bpfMapCreateArgTField.Type, bpfMapCreateArgTFieldDir, nil)
+
+		default:
+			// fmt.Printf("Ldbf: genLdbfMapCreateCall: bpfMapCreateArgTIdx %d, Got type: %T\n", bpfMapCreateArgTIdx, bpfMapCreateArgTField.Type)
+		}
+
+		// If newArg is successfully created (not nil), the replacement is performed
+		if newArg != nil {
+			replaceArg(originalStructArg.Inner[bpfMapCreateArgTIdx], newArg)
+		}
+	}
+
+	//moreCalls, _ := r.patchConditionalFields(c, s)
+	r.patchConditionalFields(c, s)
+	r.target.assignSizesCall(c)
+	calls = append(calls, c)
+	return calls
+}
