+// BpfFlowKeys mirrors the kernel's `struct bpf_flow_keys`.
+type BpfFlowKeys struct {
+	Nhoff       uint16
+	Thoff       uint16
+	AddrProto   uint16
+	IsFrag      uint8
+	IsFirstFrag uint8
+	IsEncap     uint8
+	IpProto     uint8
+	NProto      uint16
+	Sport       uint16
+	Dport       uint16
+	AddrData    [8]uint32 // Union of ipv4 and ipv6 addresses.
+	Flags       uint32
+	FlowLabel   uint32
+}
