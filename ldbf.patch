+// According to `verify_and_copy_hook_state`, only `hook` and `pf` can be set by the user.
+// The other fields (in, out, sk, net, okfn) must be zero.
+type NfHookState struct {
+	Hook uint8
+	Pf   uint8
+	_    [6]byte // Padding
+	In   uint64
+	Out  uint64
+	Sk   uint64
+	Net  uint64
+	Okfn uint64
+}
+
+// NewValidNfHookStateForTestRun creates a valid `nf_hook_state` context.
+func NewValidNfHookStateForTestRun(r *randGen) *NfHookState {
+	validHooks := []uint8{
+		NF_INET_PRE_ROUTING,
+		NF_INET_LOCAL_IN,
+		NF_INET_FORWARD,
+		NF_INET_LOCAL_OUT,
+		NF_INET_POST_ROUTING,
+	}
+	validPfs := []uint8{
+		NFPROTO_IPV4,
+		NFPROTO_IPV6,
+	}
+	ctx := &NfHookState{
+		Hook: validHooks[r.Intn(len(validHooks))],
+		Pf:   validPfs[r.Intn(len(validPfs))],
+	}
+	return ctx
+}
+
+// PatchBpfProgTestRunNf constructs valid parameters for a netfilter program.
+func PatchBpfProgTestRunNf(r *randGen, bpfProg *BpfProg) BpfProgTestRunStruct {
+	// 1. Generate the context (nf_hook_state).
+	nfCtx := NewValidNfHookStateForTestRun(r)
+	sizeOfNfCtx := unsafe.Sizeof(*nfCtx)
+	ctxIn := make([]byte, sizeOfNfCtx)
+	ctxBytesView := (*[1 << 30]byte)(unsafe.Pointer(nfCtx))[:sizeOfNfCtx:sizeOfNfCtx]
+	copy(ctxIn, ctxBytesView)
+
+	ctxSizeOut := uint32(r.Intn(MAX_Data_SIZE_IN * 2))
+	ctxOut := make([]byte, ctxSizeOut)
+	for i := range ctxOut {
+		ctxOut[i] = byte(r.Intn(256))
+	}
+
+	// 2. Determine the minimum data size based on the context.
+	var minDataSize uint32
+	if nfCtx.Hook == NF_INET_LOCAL_OUT {
+		minDataSize = SIZE_OF_IPHDR
+	} else {
+		if nfCtx.Pf == NFPROTO_IPV4 {
+			minDataSize = ETH_HLEN + SIZE_OF_IPHDR
+		} else { // NFPROTO_IPV6
+			minDataSize = ETH_HLEN + SIZE_OF_IPV6HDR
+		}
+	}
+
+	// Generate a random size that meets the minimum requirement.
+	var dataSizeIn uint32
+	var dataIn []byte
+	if r.Float64() > PACKET_FORGE_RATE {
+		// Create random input data.
+		dataSizeIn = minDataSize + uint32(r.Intn(MAX_Data_SIZE_IN))
+		dataIn = make([]byte, dataSizeIn)
+		for i := range dataIn {
+			dataIn[i] = byte(r.Intn(256))
+		}
+	} else {
+		// Create structured, valid packet data.
+		dataIn = NewValidSkBuffPacketData(r)
+		dataSizeIn = uint32(len(dataIn))
+	}
+	// fmt.Printf("BpfProgFilePath:%s, skb packet data of size %d bytes:\n", bpfProg.BpfProgFilePath, dataSizeIn)
+
+	// 3. Allocate DataOut buffer as bpf_test_finish will be called.
+	dataOut := make([]byte, dataSizeIn)
+	for i := range dataOut {
+		dataOut[i] = byte(r.Intn(256))
+	}
+
+	// From the kernel source `bpf_prog_test_run_nf`:
+	// - `flags`, `cpu`, and `batch_size` must be zero.
+	return BpfProgTestRunStruct{
+		ProgFD: bpfProg.BpfProgContext.ProgFD,
+
+		DataSizeIn:  dataSizeIn,
+		DataSizeOut: uint32(len(dataOut)),
+		DataIn:      dataIn,
+		DataOut:     dataOut,
+
+		Repeat:   uint32(r.Intn(REPEAT_TIMES)),
+		Duration: r.Uint32(),
+
+		CtxSizeIn:  uint32(sizeOfNfCtx),
+		CtxSizeOut: ctxSizeOut,
+		CtxIn:      ctxIn,
+		CtxOut:     ctxOut,
+
+		Flags:     0,
+		Cpu:       0,
+		BatchSize: 0,
+	}
+}
+
+func SetupProgTestRunContext(r *randGen, bpfProg *BpfProg) (BpfProgTestRunStruct, bool) {
+	selectProgType := bpfProg.BpfProgContext.ProgType
+	// fmt.Printf("BpfProgFilePath: %s, bpfProg.BpfProgContext.ProgType: %d\n", bpfProg.BpfProgFilePath, selectProgType)
+	switch selectProgType {
+	case BPF_PROG_TYPE_SOCKET_FILTER, BPF_PROG_TYPE_SCHED_CLS, BPF_PROG_TYPE_SCHED_ACT, BPF_PROG_TYPE_CGROUP_SKB,
+		BPF_PROG_TYPE_LWT_IN, BPF_PROG_TYPE_LWT_OUT, BPF_PROG_TYPE_LWT_XMIT, BPF_PROG_TYPE_LWT_SEG6LOCAL:
+		return PatchBpfProgTestRunSkb(r, bpfProg), true
+	case BPF_PROG_TYPE_XDP:
+		return PatchBpfProgTestRunXDP(r, bpfProg), true
+	case BPF_PROG_TYPE_RAW_TRACEPOINT:
+		return PatchBpfProgTestRunRawTp(r, bpfProg), true
+	case BPF_PROG_TYPE_FLOW_DISSECTOR:
+		return PatchBpfProgTestRunFlowDissector(r, bpfProg), true
+	case BPF_PROG_TYPE_STRUCT_OPS:
+		return PatchBpfStructOpsTestRun(r, bpfProg), true
+	case BPF_PROG_TYPE_SYSCALL:
+		return PatchBpfProgTestRunSyscall(r, bpfProg), true
+	case BPF_PROG_TYPE_TRACING:
+		return PatchBpfProgTestRunTracing(r, bpfProg), true
+	case BPF_PROG_TYPE_SK_LOOKUP:
+		return PatchBpfProgTestRunSkLookup(r, bpfProg), true
+	case BPF_PROG_TYPE_NETFILTER:
+		return PatchBpfProgTestRunNf(r, bpfProg), true
+	default:
+		return PatchBpfProgTestRunSkb(r, bpfProg), false
+	}
+}
