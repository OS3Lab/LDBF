+type BpfSkLookup struct {
+	SkOrCookie     uint64
+	Family         uint32
+	Protocol       uint32
+	RemoteIp4      uint32
+	RemoteIp6      [4]uint32
+	RemotePort     uint16
+	Padding        uint16
+	LocalIp4       uint32
+	LocalIp6       [4]uint32
+	LocalPort      uint32
+	IngressIfindex uint32
+}
+
+// NewValidBpfSkLookupForTestRun creates a valid `bpf_sk_lookup` context.
+func NewValidBpfSkLookupForTestRun(r *randGen) []byte {
+	ctx := &BpfSkLookup{
+		// sk (or cookie) must be 0 on input.
+		SkOrCookie: 0,
+		// ingress_ifindex must be 0 on input.
+		IngressIfindex: 0,
+		// local_port must be <= U16_MAX.
+		LocalPort: uint32(r.Intn(U16_MAX + 1)),
+		Protocol:  uint32(r.Intn(IPPROTO_MAX + 1)), // Random protocol number.
+	}
+
+	if r.Intn(2) == 0 {
+		ctx.Family = AF_INET
+		ctx.LocalIp4 = r.Uint32()
+		ctx.RemoteIp4 = r.Uint32()
+	} else {
+		ctx.Family = AF_INET6
+		for i := 0; i < 4; i++ {
+			ctx.LocalIp6[i] = r.Uint32()
+			ctx.RemoteIp6[i] = r.Uint32()
+		}
+	}
+
+	// RemotePort is big-endian, but for random bytes, endianness doesn't matter.
+	ctx.RemotePort = uint16(r.Uint32())
+
+	size := unsafe.Sizeof(*ctx)
+	data := make([]byte, size)
+	ctxBytesView := (*[1 << 30]byte)(unsafe.Pointer(ctx))[:size:size]
+	copy(data, ctxBytesView)
+	return data
+}
