+func selectKeyFields(r *randGen, KeyValField []KeyValSize, defaultSize KeyValSize) (KeyValSize, bool) {
+	// If there are no predefined sizes, do nothing.
+
+	if len(KeyValField) == 0 {
+		return defaultSize, true
+	}
+
+	// 1. Generate a random INDEX for the slice.
+	randomIndex := int(r.rand(len(KeyValField)))
+
+	// 2. Use the index to select ONE element from the allowed sizes.
+	selectedSize := KeyValField[randomIndex]
+
+	return selectedSize, true
+}
